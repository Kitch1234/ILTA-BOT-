import os


CHAMPION_PATH = "assets/champions"



# =====================================
# Определение редкости скина
# =====================================

def detect_skin_tier(skin_name):

    name = skin_name.lower()


    if "prestige" in name:
        return "Престижный"


    if "ultimate" in name:
        return "Чемпионский"


    if "legendary" in name:
        return "Легендарный"


    if "mythic" in name:
        return "Мифический"


    if "epic" in name:
        return "Эпический"


    if "rare" in name:
        return "Редкий"


    # Classic / базовый скин
    return "Обычный"





# =====================================
# Загрузка чемпионов
# =====================================

def load_champions():

    champions = {}


    if not os.path.exists(CHAMPION_PATH):

        print(
            "❌ Папка champions не найдена"
        )

        return {}



    for region in os.listdir(CHAMPION_PATH):


        region_path = os.path.join(

            CHAMPION_PATH,

            region

        )


        if not os.path.isdir(region_path):

            continue




        for champion in os.listdir(region_path):


            champion_path = os.path.join(

                region_path,

                champion

            )


            if not os.path.isdir(champion_path):

                continue



            skins = []



            for file in os.listdir(champion_path):


                if not file.lower().endswith(

                    (".png", ".jpg", ".jpeg")

                ):

                    continue



                skin_name = os.path.splitext(

                    file

                )[0]



                skins.append({

                    "name": skin_name,

                    "file": os.path.join(

                        champion_path,

                        file

                    ),

                    "tier": detect_skin_tier(

                        skin_name

                    )

                })



            if skins:


                champions[champion] = {


                    "region": region,


                    "skins": skins

                }




    print(

        f"🌟 Загружено чемпионов: {len(champions)}"

    )


    return champions
