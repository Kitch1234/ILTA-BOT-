def create_embed(card, index):

    embed = discord.Embed(
        color=0xD4AF37
    )

    embed.add_field(
        name="🛡 Чемпион",
        value=card["champion"],
        inline=True
    )

    if card["skin"]:
        embed.add_field(
            name="✨ Образ",
            value=card["skin"],
            inline=True
        )

    embed.add_field(
        name="⚔ Атака",
        value=str(card["attack"]),
        inline=True
    )

    embed.add_field(
        name="❤️ Здоровье",
        value=str(card["health"]),
        inline=True
    )

    embed.add_field(
        name="🛡 Защита",
        value=str(card["defense"]),
        inline=True
    )

    ability = card.get("ability")

    if ability:
        name = ability.get("name", "Без названия")
        description = ability.get("description", "Нет описания")

        embed.add_field(
            name=f"✨ {name}",
            value=description,
            inline=False
        )

    embed.set_footer(
        text=f"🎴 Карта {index + 1}/3"
    )

    return embed
