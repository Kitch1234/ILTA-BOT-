def fit_image(

    image,

    size,

    zoom=0.65

):

    target_w, target_h = size


    ratio = min(

        target_w / image.width,

        target_h / image.height

    )


    ratio *= zoom



    new_size = (

        int(image.width * ratio),

        int(image.height * ratio)

    )


    image = image.resize(

        new_size,

        Image.LANCZOS

    )



    canvas = Image.new(

        "RGBA",

        (
            target_w,
            target_h
        ),

        (0,0,0,0)

    )



    x = (

        target_w - image.width

    ) // 2



    y = (

        target_h - image.height

    ) // 2



    canvas.alpha_composite(

        image,

        (
            x,
            y
        )

    )


    return canvas
