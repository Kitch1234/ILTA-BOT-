# =====================================

def spaced_text(text, spacing=0):

    if spacing <= 0:
        return text

    return (" " * spacing).join(list(text))


# =====================================
# ПОМОЩНИКИ ТЕКСТА
# =====================================

def fit_font(
    draw,
    text,
    start_size=42,
    bold=True,
    max_width=850,
    min_size=16
):

    font_path = FONT_BOLD if bold else FONT_REGULAR
    size = start_size

    while size >= min_size:
        font = get_font(font_path, size)

        bbox = draw.textbbox(
            (0, 0),
            text,
            font=font
        )

        width = bbox[2] - bbox[0]

        if width <= max_width:
            return font

        size -= 2

    return get_font(font_path, min_size)





def draw_center_text(
    draw,
    position,
    text,
    size,
    bold=True,
    max_width=850,
    shadow_offset=(3, 3),
    fill=TEXT_COLOR,
    shadow_fill=TEXT_SHADOW,
    spacing=0
):

    if not text:
        return

    if spacing:
        text = spaced_text(text, spacing)

    font = fit_font(
        draw,
        text,
        start_size=size,
        bold=bold,
        max_width=max_width
    )

    bbox = draw.textbbox(
        (0, 0),
        text,
        font=font
    )

    width = bbox[2] - bbox[0]

    x = position[0] - width // 2
    y = position[1]

    draw.text(
        (
            x + shadow_offset[0],
            y + shadow_offset[1]
        ),
        text,
        font=font,
        fill=shadow_fill
    )

    draw.text(
        (
            x,
            y
        ),
        text,
        font=font,
        fill=fill
    )





def draw_stat(
    draw,
    position,
    value
    fill=text_color,
    shadow_fill=shadow_color
):

    draw_center_text(
        draw,
        position,
        str(value),
        60,
        bold=True,
        max_width=120,
        shadow_offset=(2, 2),
        fill=fill
        shadow_fill=shadow_fill
    )





def wrap_text(
    text,
    max_chars=35
):

    if not text:
        return []

    words = text.split()
    lines = []
    current = ""

    for word in words:
        candidate = f"{current} {word}".strip()

        if len(candidate) <= max_chars:
            current = candidate
        else:
            if current:
                lines.append(current)
            current = word

    if current:
        lines.append(current)

    return lines





def normalize_ability(ability):
    """
    ability может быть строкой или словарём.
    Возвращает (title, description)
    """

    if isinstance(ability, dict):
        title = str(ability.get("name", "")).strip()
        description = str(ability.get("description", "")).strip()
        return title, description

    if ability is None:
        return "", ""

    return str(ability).strip(), ""





def draw_ability_block(
    draw,
    ability,
    rarity="Обычный"
):

    title, description = normalize_ability(ability)

    if not title and not description:
        return

    start_x = CARD_LAYOUT["ability"][0]
    start_y = CARD_LAYOUT["ability"][1]

    if title:
        draw_center_text(
            draw,
            (start_x, start_y),
            title,
            40,
            bold=True,
            max_width=840,
            shadow_offset=(2, 2),
            fill=TEXT_COLOR
        )

    if description:
        lines = wrap_text(description, 42)

        y = start_y + 34

        for line in lines[:2]:
            draw_center_text(
                draw,
                (start_x, y),
                line,
                30,
                bold=False,
                max_width=860,
                shadow_offset=(2, 2),
                fill=TEXT_COLOR
            )
            y += 30





