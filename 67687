from data.ability_loader import get_ability

from generators.card_generator import create_card


RARITY_ORDER = [
    "Обычный",
    "Редкий",
    "Эпический",
    "Легендарный",
    "Мифический",
    "Престижный",
    "Чемпионский",
]

RARITY_EMOJIS = {
    "Обычный": "⚪",
    "Редкий": "🔵",
    "Эпический": "🟣",
    "Легендарный": "🟠",
    "Мифический": "🔴",
    "Престижный": "💎",
    "Чемпионский": "✨",
}

RARITY_LABELS = {
    "Обычный": "Обычная",
    "Редкий": "Редкая",
    "Эпический": "Эпическая",
    "Легендарный": "Легендарная",
    "Мифический": "Мифическая",
    "Престижный": "Престижная",
    "Чемпионский": "Чемпионская",
}

RARITY_COLORS = {
    "Обычный": 0xB7B7B7,
    "Редкий": 0x5CC8FF,
    "Эпический": 0xC084FC,
    "Легендарный": 0xF59E0B,
    "Мифический": 0xFB7185,
    "Престижный": 0xFDE68A,
    "Чемпионский": 0x5EEAD4,
}


# =====================================
# HELPERS
# =====================================

def group_cards_by_rarity():
    grouped = defaultdict(list)

    for card in load_cards().values():
        rarity = card.get("rarity", "Обычный")
        grouped[rarity].append(card)

    return grouped


def pick_random_card_equally(grouped_cards):
    available_rarities = [
        rarity for rarity in RARITY_ORDER if grouped_cards.get(rarity)
    ]

    extra_rarities = [
        rarity for rarity in grouped_cards.keys()
        if rarity not in available_rarities
    ]

    available_rarities.extend(extra_rarities)

    if not available_rarities:
        raise ValueError("В cards.json нет доступных карт.")

    rarity = random.choice(available_rarities)
    return random.choice(grouped_cards[rarity])


def build_card_message(card):
    rarity = card.get("rarity", "Обычный")
    emoji = RARITY_EMOJIS.get(rarity, "🎴")
    label = RARITY_LABELS.get(rarity, rarity)

    champion = card.get("champion", "Неизвестно")
    skin = card.get("skin", "")
    region = card.get("region", "Неизвестно")

    lines = [
        f"{emoji} **{label} карта!**",
        f"⚔️ **{champion}**",
    ]

    if skin and skin.lower() != "default":
        lines.append(f"👑 **{skin}**")

    lines.append(f"🌍 **{region}**")

    return "\n".join(lines)


def create_embed(card, index, total=3):
    rarity = card.get("rarity", "Обычный")
    emoji = RARITY_EMOJIS.get(rarity, "🎴")
    label = RARITY_LABELS.get(rarity, rarity)

    champion = card.get("champion", "Неизвестно")
    skin = card.get("skin", "")
    region = card.get("region", "Неизвестно")
    attack = card.get("attack", 0)
    health = card.get("health", 0)
    defense = card.get("defense", 0)

    embed = discord.Embed(
        title=f"{emoji} {label} карта",
        description="Карта добавлена в коллекцию.",
        color=RARITY_COLORS.get(rarity, 0xD4AF37)
    )

    embed.add_field(
        name="🛡 Чемпион",
        value=champion,
        inline=True
    )

    if skin and skin.lower() != "default":
        embed.add_field(
            name="✨ Образ",
            value=skin,
            inline=True
        )

    embed.add_field(
        name="🌍 Регион",
        value=region,
        inline=True
    )

    embed.add_field(
        name="⚔ Атака",
        value=str(attack),
        inline=True
    )

    embed.add_field(
        name="❤️ Здоровье",
        value=str(health),
        inline=True
    )

    embed.add_field(
        name="🛡 Защита",
        value=str(defense),
        inline=True
    )

    ability = card.get("ability") or {}

    if isinstance(ability, dict):
        ability_name = ability.get("name", "").strip()
        ability_description = ability.get("description", "").strip()

        if ability_name or ability_description:
            embed.add_field(
                name=f"✨ {ability_name or 'Способность'}",
                value=ability_description or "Нет описания",
                inline=False
            )

    embed.set_footer(
        text=f"🎴 Карта {index + 1}/{total}"
    )

    return embed


# =====================================
# VIEW ПАКА
# =====================================

class PackView(discord.ui.View):

    def __init__(self, cards):
        super().__init__(timeout=180)
        self.cards = cards
        self.index = 0

    async def update_card(self, interaction: discord.Interaction):
        await interaction.response.defer()

        card = self.cards[self.index]
        file_name = os.path.basename(card["file"])

        embed = create_embed(card, self.index, len(self.cards))

        file = discord.File(
            card["file"],
            filename=file_name
        )

        embed.set_image(
            url=f"attachment://{file_name}"
        )

        await interaction.edit_original_response(
            content=build_card_message(card),
            embed=embed,
            attachments=[file],
            view=self
        )

    # =====================================
    # КНОПКА НАЗАД
    # =====================================

    @discord.ui.button(
        emoji="⬅️",
        style=discord.ButtonStyle.secondary
    )
    async def left(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):
        self.index -= 1

        if self.index < 0:
            self.index = len(self.cards) - 1

        await self.update_card(interaction)

    # =====================================
    # КНОПКА ВПЕРЁД
    # =====================================

    @discord.ui.button(
        emoji="➡️",
        style=discord.ButtonStyle.secondary
    )
    async def right(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):
        self.index += 1

        if self.index >= len(self.cards):
            self.index = 0

        await self.update_card(interaction)


# =====================================
# PACK
# =====================================

class Pack(commands.Cog):

    def __init__(self, bot):
        self.bot = bot

    # =====================================
    # OPEN PACK
    # =====================================

    @app_commands.command(
        name="open_pack",
        description="Открыть ILTA Pack"
    )
    async def open_pack(
        self,
        interaction: discord.Interaction
    ):
        await interaction.response.defer(thinking=True)

        cards = []
        cards_by_rarity = group_cards_by_rarity()

        # =====================================
        # СОЗДАНИЕ 3 КАРТ
        # =====================================

        for _ in range(3):
            # -----------------------------
            # Случайная карта из cards.json
            # -----------------------------
            card_data = pick_random_card_equally(cards_by_rarity)

            champion_name = card_data["champion"]
            skin_name = card_data["skin"]
            rarity = card_data["rarity"]
            region = card_data["region"]
            card_id = card_data["id"]

            image_path = get_art_path(card_data)

            # -----------------------------
            # Способность
            # -----------------------------
            ability_data = get_ability(card_id)
            ability = ability_data if ability_data else {}

            # -----------------------------
            # Статы
            # -----------------------------
            attack = random.randint(20, 100)
            health = random.randint(50, 150)
            defense = random.randint(10, 80)

            code = f"{random.randint(1, 9999):04}"

            # -----------------------------
            # Генерация изображения
            # -----------------------------
            try:
                card_file = await asyncio.wait_for(
                    asyncio.to_thread(
                        create_card,
                        champion_name,
                        skin_name,
                        rarity,
                        region,
                        attack,
                        health,
                        defense,
                        card_id,
                        image_path,
                        code
                    ),
                    timeout=15
                )

            except asyncio.TimeoutError:
                await interaction.edit_original_response(
                    content="❌ Генерация карты заняла слишком много времени."
                )
                return

            except Exception as e:
                await interaction.edit_original_response(
                    content=f"❌ Ошибка генерации карты:\n```{e}```"
                )
                return

            # -----------------------------
            # Сохранение в PostgreSQL
            # -----------------------------
            try:
                await add_card(
                    interaction.user.id,
                    code,
                    champion_name,
                    skin_name,
                    region,
                    rarity,
                    attack,
                    defense,
                    health
                )

            except Exception as e:
                await interaction.edit_original_response(
                    content=f"❌ Ошибка PostgreSQL:\n```{e}```"
                )
                return

            # -----------------------------
            # Добавляем карту в список
            # -----------------------------
            cards.append({
                "champion": champion_name,
                "skin": skin_name,
                "rarity": rarity,
                "region": region,
                "attack": attack,
                "health": health,
                "defense": defense,
                "ability": ability,
                "code": code,
                "file": card_file,
            })

        # =====================================
        # Показ первой карты
        # =====================================
        first = cards[0]
        file_name = os.path.basename(first["file"])

        embed = create_embed(first, 0, len(cards))
        file = discord.File(
            first["file"],
            filename=file_name
        )

        embed.set_image(
            url=f"attachment://{file_name}"
        )

        view = PackView(cards)

        await interaction.edit_original_response(
            content=build_card_message(first),
            embed=embed,
            attachments=[file],
            view=view
        )


# =====================================
# SETUP
# =====================================

async def setup(bot):
    await bot.add_cog(Pack(bot))
