import json


CARDS_FILE = "data/cards_ru.json"
RARITY_FILE = "data/skin_rarity.json"


# ==========================
# ЗАГРУЗКА
# ==========================

with open(
    CARDS_FILE,
    "r",
    encoding="utf-8"
) as f:

    cards = json.load(f)



with open(
    RARITY_FILE,
    "r",
    encoding="utf-8"
) as f:

    rarity = json.load(f)



# ==========================
# ДОБАВЛЯЕМ РЕДКОСТЬ
# ==========================

for card_id, card in cards.items():

    if card_id in rarity:

        card["rarity"] = rarity[card_id]



# ==========================
# СОХРАНЕНИЕ
# ==========================

with open(
    CARDS_FILE,
    "w",
    encoding="utf-8"
) as f:

    json.dump(
        cards,
        f,
        ensure_ascii=False,
        indent=4
    )



print(
    f"✅ Редкость добавлена для {len(cards)} карт"
)
