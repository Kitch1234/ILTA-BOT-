    "Обычный": {
        "chance": 59,
        "color": "#808080"
    },

    "Редкий": {
        "chance": 25,
        "color": "#3498DB"
    },

    "Эпический": {
        "chance": 10,
        "color": "#9B59B6"
    },

    "Легендарный": {
        "chance": 4,
        "color": "#F39C12"
    },

    "Мифический": {
