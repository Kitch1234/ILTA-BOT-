import os
import json
import requests
from PIL import Image
from io import BytesIO


# =========================
# НАСТРОЙКИ
# =========================

TARGET_REGIONS = [
    "Demacia",
    "Noxus"
]


CHAMPIONS_JSON = (
    "data/champions.json"
)


OUTPUT = (
    "assets/champions"
)



# =========================
# ИМЕНА
# =========================

def clean_name(name):

    name = name.replace(
        " ",
        "_"
    )

    name = name.replace(
        ":",
        ""
    )

    name = name.replace(
        "'",
        ""
    )

    return name



# =========================
# СКАЧИВАНИЕ
# =========================

def download_image(
    url,
    path
):

    try:

        response = requests.get(
            url,
            timeout=20
        )


        if response.status_code != 200:

            return False



        image = Image.open(
            BytesIO(
                response.content
            )
        )


        image = image.convert(
            "RGB"
        )


        image.save(
            path,
            "WEBP",
            quality=95
        )


        return True



    except Exception as error:

        print(
            "Ошибка:",
            error
        )

        return False



# =========================
# ЗАГРУЗКА JSON
# =========================

with open(
    CHAMPIONS_JSON,
    "r",
    encoding="utf-8"
) as file:

    champions = json.load(
        file
    )



# =========================
# ПОИСК РЕГИОНА
# =========================

def find_region(
    champion
):

    for region in TARGET_REGIONS:


        path = os.path.join(

            OUTPUT,

            region,

            champion

        )


        if os.path.exists(path):

            return region



    return None



# =========================
# ОСНОВА
# =========================

for champion_name, data in champions.items():


    region = find_region(
        champion_name
    )


    if not region:

        continue



    print(
        "\n🌍",
        region,
        "|",
        champion_name
    )



    champion_folder = os.path.join(

        OUTPUT,

        region,

        champion_name

    )


    os.makedirs(
        champion_folder,
        exist_ok=True
    )



    for skin in data.get(
        "skins",
        []
    ):


        skin_name = skin.get(
            "name",
            "default"
        )


        skin_id = skin.get(
            "id",
            0
        )



        if skin_name == "default":

            filename = "Base.webp"

        else:

            filename = (
                clean_name(
                    skin_name
                )
                +
                ".webp"
            )



        save_path = os.path.join(

            champion_folder,

            filename

        )



        if os.path.exists(save_path):

            print(
                "✔ Уже есть:",
                filename
            )

            continue



        # =====================
        # RIOT SPLASH ART
        # =====================

        url = (

            "https://ddragon.leagueoflegends.com/"

            "cdn/img/champion/splash/"

            f"{champion_name}_{skin_id}.jpg"

        )



        print(
            "⬇ Скачивание:",
            skin_name
        )



        result = download_image(

            url,

            save_path

        )


        if result:

            print(
                "  ✅ Сохранено"
            )

        else:

            print(
                "  ❌ Не найдено"
            )



print(
    "\n===================="
)

print(
    "✅ Загрузка завершена"
)

print(
    "===================="
)
