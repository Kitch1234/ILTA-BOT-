import discord
from discord.ext import commands
from discord import app_commands

import random
import os

from database.cards import add_card

from data.champion_loader import load_champions
from data.loot import get_card_rarity

from data.translations import (
    get_skin_name,
    get_champion_name
)

from generators.card_generator import create_card



# =========================
# НАСТРОЙКИ PACK
# =========================

PACK_SIZE = 3



class Pack(commands.Cog):


    def __init__(self, bot):

        self.bot = bot

        self.champions = load_champions()



    @app_commands.command(
        name="open_pack",
        description="Открыть ILTA Pack"
    )
    async def open_pack(
        self,
        interaction: discord.Interaction
    ):


        await interaction.response.defer()



        if not self.champions:

            await interaction.followup.send(
                "❌ Нет доступных чемпионов"
            )

            return



        await interaction.followup.send(

            f"🎁 **{interaction.user.name} открыл ILTA Pack ({PACK_SIZE} карты)**"

        )



        for number in range(1, PACK_SIZE + 1):


            # =====================
            # ЧЕМПИОН
            # =====================

            champion_id = random.choice(

                list(
                    self.champions.keys()
                )

            )


            champion = self.champions[champion_id]



            region = champion.get(
                "region",
                "Runeterra"
            )



            # =====================
            # СКИН
            # =====================

            skins = champion.get(
                "skins",
                []
            )


            if not skins:
                continue



            skin = random.choice(
                skins
            )


            skin_name = skin["name"]

            image_path = skin["file"]



            # =====================
            # ИМЕНА
            # =====================

            champion_ru = get_champion_name(
                champion_id
            )


            skin_ru = get_skin_name(
                skin_name
            )



            # =====================
            # РЕДКОСТЬ
            # =====================

            rarity = get_card_rarity()



            # =====================
            # СТАТЫ
            # =====================

            attack = random.randint(
                20,
                100
            )


            health = random.randint(
                50,
                150
            )


            defense = random.randint(
                10,
                80
            )



            # =====================
            # ID
            # =====================

            card_code = (
                f"{random.randint(1,9999):04}"
            )



            # =====================
            # БАЗА
            # =====================

            await add_card(

                interaction.user.id,

                card_code,

                champion_id,

                skin_name,

                region,

                rarity,

                attack,

                defense,

                health

            )



            # =====================
            # КАРТА PNG
            # =====================

            card_file = create_card(

                champion=champion_ru,

                skin=skin_ru,

                rarity=rarity,

                region=region,

                attack=attack,

                health=health,

                defense=defense,

                image_path=image_path,

                card_number=card_code

            )



            # =====================
            # EMBED
            # =====================

            embed = discord.Embed(

                title=(

                    f"🎴 {rarity} | {champion_ru}"

                ),

                description=(

                    f"✨ **{skin_ru}**\n"

                    f"🆔 {card_code}"

                ),

                color=0xFFD700

            )



            embed.add_field(
                name="⚔ Атака",
                value=str(attack),
                inline=True
            )


            embed.add_field(
                name="❤️ Здоровье",
                value=str(health),
                inline=True
            )


            embed.add_field(
                name="🛡 Защита",
                value=str(defense),
                inline=True
            )


            embed.add_field(
                name="🌍 Регион",
                value=region,
                inline=True
            )



            file = discord.File(
                card_file
            )


            embed.set_image(

                url=(

                    "attachment://"

                    +

                    os.path.basename(card_file)

                )

            )



            embed.set_footer(

                text=f"Карта {number}/{PACK_SIZE}"

            )



            await interaction.followup.send(

                embed=embed,

                file=file

            )




async def setup(bot):

    await bot.add_cog(
        Pack(bot)
    )
