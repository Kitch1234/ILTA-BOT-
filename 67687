from PIL import Image, ImageDraw, ImageFont
import os


# =====================================
# РАЗМЕР КАРТЫ
# =====================================

CARD_WIDTH = 1064
CARD_HEIGHT = 1478


ASSETS = "assets"

OUTPUT = "generated_cards"



# =====================================
# ШРИФТЫ
# =====================================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =====================================
# РАМКИ ПО РЕДКОСТИ
# =====================================

FRAME_PATHS = {

    "Обычный": "common.png",

    "Редкий": "rare.png",

    "Эпический": "epic.png",

    "Легендарный": "legendary.png",

    "Мифический": "mythic.png",

    "Престижный": "prestige.png",

    "Чемпионский": "ultimate.png"

}



# =====================================
# РЕГИОНЫ
# =====================================

REGION_ICONS = {

    "Демасия": "Demacia.png",

    "Ноксус": "Noxus.png"

}


REGION_PATH = os.path.join(

    ASSETS,

    "regions"

)



# =====================================
# РАСПОЛОЖЕНИЕ АРТА
# =====================================

ART_WIDTH = 990
ART_HEIGHT = 1000


ART_X = (

    CARD_WIDTH - ART_WIDTH

) // 2


ART_Y = 35



# =====================================
# РАСПОЛОЖЕНИЕ ЭЛЕМЕНТОВ
# =====================================

CARD_LAYOUT = {

    # номер карты
    "number": (900, 80),


    # название чемпиона
    "champion": (532, 1160),


    # название скина
    "skin": (532, 1220),


    # статы
    "attack": (250, 1340),

    "health": (530, 1340),

    "defense": (810, 1340),


    # способность снизу
    "ability": (532, 1405)

}
# =====================================
# ШРИФТЫ
# =====================================

def get_font(path, size):

    return ImageFont.truetype(
        path,
        size
    )



# =====================================
# ЦЕНТРИРОВАННЫЙ ТЕКСТ
# =====================================

def draw_center_text(
    draw,
    position,
    text,
    size,
    bold=True
):

    font = get_font(
        FONT_BOLD if bold else FONT_REGULAR,
        size
    )


    bbox = draw.textbbox(
        (0,0),
        text,
        font=font
    )


    width = bbox[2] - bbox[0]


    x = position[0] - width // 2


    y = position[1]



    # тень

    draw.text(

        (
            x + 3,
            y + 3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )



    # основной текст

    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )




# =====================================
# ТЕКСТ В ДВЕ СТРОКИ
# =====================================

def draw_multiline_center(

    draw,

    position,

    text,

    size

):


    font = get_font(

        FONT_BOLD,

        size

    )


    words = text.split(" ")


    lines = []

    current = ""



    for word in words:


        test = current + " " + word


        if len(test) > 18:


            lines.append(current)

            current = word


        else:

            current = test



    if current:

        lines.append(current)



    y = position[1]



    for line in lines:


        draw_center_text(

            draw,

            (
                position[0],
                y
            ),

            line.strip(),

            size

        )


        y += size + 5




# =====================================
# ИКОНКА РЕГИОНА
# =====================================

def add_region_icon(

    card,

    region

):


    icon_name = REGION_ICONS.get(

        region

    )


    if not icon_name:

        return



    path = os.path.join(

        REGION_PATH,

        icon_name

    )



    if not os.path.exists(path):

        return



    icon = Image.open(

        path

    ).convert(

        "RGBA"

    )



    icon = icon.resize(

        (
            80,
            80
        ),

        Image.LANCZOS

    )



    card.alpha_composite(

        icon,

        (
            50,
            50
        )

    )
# =====================================
# ПОДГОТОВКА АРТА
# =====================================

def prepare_art(image):


    image = image.convert(
        "RGBA"
    )


    ratio = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    new_size = (

        int(image.width * ratio),

        int(image.height * ratio)

    )


    image = image.resize(

        new_size,

        Image.LANCZOS

    )


    left = (

        image.width - ART_WIDTH

    ) // 2



    top = (

        image.height - ART_HEIGHT

    ) // 2



    image = image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )


    return image




# =====================================
# СОЗДАНИЕ КАРТЫ
# =====================================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    ability,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    card = Image.new(

        "RGBA",

        (

            CARD_WIDTH,

            CARD_HEIGHT

        ),

        (0,0,0,0)

    )



    # ==============================
    # АРТ
    # ==============================

    art = Image.open(

        image_path

    )


    art = prepare_art(

        art

    )



    card.alpha_composite(

        art,

        (

            ART_X,

            ART_Y

        )

    )



    # ==============================
    # РАМКА
    # ==============================

    frame_file = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_file

    )



    if os.path.exists(frame_path):


        frame = Image.open(

            frame_path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (

                CARD_WIDTH,

                CARD_HEIGHT

            ),

            Image.LANCZOS

        )


        card.alpha_composite(

            frame

        )



    # ==============================
    # РЕГИОН
    # ==============================

    add_region_icon(

        card,

        region

    )



    draw = ImageDraw.Draw(

        card

    )



    # ==============================
    # НОМЕР
    # ==============================

    draw_center_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        34

    )



    # ==============================
    # ЧЕМПИОН
    # ==============================

    draw_multiline_center(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        52

    )



    # ==============================
    # СКИН
    # ==============================

    if skin:


        draw_multiline_center(

            draw,

            CARD_LAYOUT["skin"],

            skin,

            34

        )



    # ==============================
    # СТАТЫ
    # ==============================

    draw_center_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )
    # ==============================
    # СПОСОБНОСТЬ
    # ==============================

    if ability:


        draw_center_text(

            draw,

            CARD_LAYOUT["ability"],

            ability,

            28,

            False

        )



    # ==============================
    # СОХРАНЕНИЕ
    # ==============================

    filename = (

        f"{champion}_{skin}_{card_number}.png"

    )


    filename = filename.replace(

        " ",

        "_"

    )



    path = os.path.join(

        OUTPUT,

        filename

    )



    card.save(

        path,

        optimize=True,

        compress_level=9

    )



    return path
