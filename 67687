import json
import os
import requests


CHAMPIONS_JSON = "data/champions.json"

REGIONS = [
    "Demacia",
    "Noxus"
]


ASSETS = "assets/champions"


def get_champion_list():

    url = (
        "https://ddragon.leagueoflegends.com/"
        "cdn/15.10.1/data/en_US/champion.json"
    )

    data = requests.get(url).json()

    result = {}

    for champ in data["data"].values():

        result[champ["name"]] = int(
            champ["key"]
        )

    return result



def main():

    ids = get_champion_list()


    with open(
        CHAMPIONS_JSON,
        "r",
        encoding="utf-8"
    ) as f:

        champions = json.load(f)



    updated = 0



    for region in REGIONS:


        region_path = os.path.join(
            ASSETS,
            region
        )


        if not os.path.exists(region_path):
            continue



        for folder in os.listdir(region_path):


            if folder not in champions:
                continue



            # ищем имя Riot

            name = folder.replace(
                "_",
                " "
            )


            if name in ids:

                champions[folder]["id"] = ids[name]

                updated += 1

                print(
                    "✔",
                    region,
                    folder,
                    ids[name]
                )

            else:

                print(
                    "⚠ Не найден:",
                    folder
                )



    with open(
        CHAMPIONS_JSON,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            champions,
            f,
            ensure_ascii=False,
            indent=4
        )


    print()
    print(
        "Готово. Обновлено:",
        updated
    )



if __name__ == "__main__":

    main()
