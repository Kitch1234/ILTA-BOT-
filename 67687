import json
import os


INPUT = "data/cards_ru.json"

OUTPUT = "data/skin_rarity.json"


# ==================================
# ОСОБЫЕ РЕДКОСТИ
# ==================================

SPECIAL_RARITY = {

    # Престижные
    "Garen_43": "Престижный",

    # Легендарные
    "Garen_24": "Легендарный"

}



# ==================================
# ЗАГРУЗКА
# ==================================

with open(
    INPUT,
    "r",
    encoding="utf-8"
) as f:

    cards = json.load(f)



rarity = {}



for card_id, data in cards.items():


    # базовый чемпион

    if data["skin"] == "":

        rarity[card_id] = "Обычный"


    # если есть ручное значение

    elif card_id in SPECIAL_RARITY:

        rarity[card_id] = SPECIAL_RARITY[card_id]


    else:

        # пока все остальные
        # ставим временно

        rarity[card_id] = "Редкий"



# ==================================
# СОХРАНЕНИЕ
# ==================================

with open(
    OUTPUT,
    "w",
    encoding="utf-8"
) as f:

    json.dump(
        rarity,
        f,
        ensure_ascii=False,
        indent=4
    )


print(
    f"✅ Создано редкостей: {len(rarity)}"
)
