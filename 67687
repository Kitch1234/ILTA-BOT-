from PIL import Image, ImageDraw, ImageFont
import os



# =========================
# РАЗМЕР КАРТЫ
# =========================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"

OUTPUT = "generated_cards"



# =========================
# ШРИФТЫ
# =========================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =========================
# РАМКИ
# =========================

FRAME_PATHS = {

    "Обычный": "common.png",
    "Редкий": "rare.png",
    "Эпический": "epic.png",
    "Легендарный": "legendary.png",
    "Мифический": "mythic.png"

}



# =========================
# КООРДИНАТЫ
# =========================

CARD_LAYOUT = {

    "number": (900, 90),

    "champion": (530, 1010),

    "skin": (530, 1080),

    "attack": (250, 1210),

    "health": (530, 1210),

    "defense": (810, 1210),

    "region_text": (250, 1380),

    "rarity": (820, 1380)

}



# =========================
# ШРИФТ
# =========================

def get_font(path, size):

    return ImageFont.truetype(
        path,
        size
    )



# =========================
# ТЕКСТ
# =========================

def draw_text(
    draw,
    position,
    text,
    size,
    bold=True
):

    font = get_font(

        FONT_BOLD if bold
        else FONT_REGULAR,

        size

    )


    x, y = position


    draw.text(

        (
            x + 3,
            y + 3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )


    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )



# =========================
# АРТ С РАСШИРЕНИЕМ КРАЁВ
# =========================

def fit_image(image, size):

    target_w, target_h = size


    # сохраняем оригинальные пропорции

    ratio = target_h / image.height


    new_w = int(
        image.width * ratio
    )


    image = image.resize(

        (
            new_w,
            target_h
        ),

        Image.LANCZOS

    )



    # если арт шире карты

    if new_w >= target_w:


        left = (
            new_w - target_w
        ) // 2


        return image.crop(

            (
                left,
                0,
                left + target_w,
                target_h
            )

        )



    # создаём новое полотно

    result = Image.new(

        "RGBA",

        (
            target_w,
            target_h
        )

    )



    side = (

        target_w - new_w

    ) // 2



    # левый край

    left_part = image.crop(

        (
            0,
            0,
            20,
            target_h
        )

    )


    left_part = left_part.resize(

        (
            side,
            target_h
        ),

        Image.LANCZOS

    )


    result.alpha_composite(

        left_part,

        (
            0,
            0
        )

    )



    # центр

    result.alpha_composite(

        image,

        (
            side,
            0
        )

    )



    # правый край

    right_part = image.crop(

        (
            new_w-20,
            0,
            new_w,
            target_h
        )

    )


    right_part = right_part.resize(

        (
            side,
            target_h
        ),

        Image.LANCZOS

    )


    result.alpha_composite(

        right_part,

        (
            side + new_w,
            0
        )

    )


    return result




# =========================
# СОЗДАНИЕ КАРТЫ
# =========================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    card = Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,0)

    )



    # =====================
    # АРТ
    # =====================

    art = Image.open(

        image_path

    ).convert(

        "RGBA"

    )


    art = fit_image(

        art,

        (
            CARD_WIDTH,
            CARD_HEIGHT
        )

    )


    card.alpha_composite(

        art

    )



    # =====================
    # РАМКА
    # =====================

    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )



    if os.path.exists(frame_path):


        frame = Image.open(

            frame_path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            ),

            Image.LANCZOS

        )


        card.alpha_composite(

            frame

        )



    draw = ImageDraw.Draw(

        card

    )



    # =====================
    # ТЕКСТ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        36

    )


    draw_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        54

    )


    draw_text(

        draw,

        CARD_LAYOUT["skin"],

        skin,

        38,

        False

    )



    # =====================
    # СТАТЫ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )



    # =====================
    # НИЗ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["region_text"],

        region,

        34

    )


    draw_text(

        draw,

        CARD_LAYOUT["rarity"],

        rarity,

        34

    )



    # =====================
    # СОХРАНЕНИЕ
    # =====================

    filename = (

        f"{champion}_{skin}_{card_number}.png"

    ).replace(

        " ",

        "_"

    )


    path = os.path.join(

        OUTPUT,

        filename

    )


    card.save(

        path

    )


    return path
