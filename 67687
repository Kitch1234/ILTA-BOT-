import os
import json
import requests
from PIL import Image
from io import BytesIO


REGIONS = [
    "Demacia",
    "Noxus"
]


CHAMPIONS_JSON = "data/champions.json"

OUTPUT = "assets/champions"



def clean_name(name):

    return (
        name
        .replace(" ", "_")
        .replace(":", "")
        .replace("'", "")
    )



def download(url, path):

    try:

        r = requests.get(
            url,
            timeout=20
        )


        if r.status_code != 200:
            return False


        img = Image.open(
            BytesIO(r.content)
        )


        img.save(
            path,
            "WEBP"
        )


        return True


    except Exception as e:

        print(
            "Ошибка:",
            e
        )

        return False



with open(
    CHAMPIONS_JSON,
    "r",
    encoding="utf-8"
) as f:

    champions = json.load(f)



for champion, data in champions.items():


    region = None


    for r in REGIONS:

        test = os.path.join(
            OUTPUT,
            r,
            champion
        )


        if os.path.exists(test):

            region = r
            break



    if not region:
        continue



    print(
        "\n🌍",
        region,
        champion
    )


    folder = os.path.join(
        OUTPUT,
        region,
        champion
    )


    os.makedirs(
        folder,
        exist_ok=True
    )



    # Riot champion key

    champion_key = data.get(
        "key",
        champion
    )



    for skin in data["skins"]:


        skin_name = skin["name"]

        skin_id = skin["id"]



        if skin_name == "default":

            filename = "Base.webp"

        else:

            filename = (
                clean_name(
                    skin_name
                )
                +
                ".webp"
            )



        path = os.path.join(
            folder,
            filename
        )



        if os.path.exists(path):

            print(
                "✔",
                filename
            )

            continue



        # centered splash

        if skin_id == 0:

            url = (
                f"https://ddragon.leagueoflegends.com/"
                f"cdn/img/champion/splash/"
                f"{champion}_0.jpg"
            )

        else:

            url = (
                f"https://ddragon.leagueoflegends.com/"
                f"cdn/img/champion/splash/"
                f"{champion}_{skin_id}.jpg"
            )



        print(
            "⬇",
            skin_name
        )


        if download(
            url,
            path
        ):

            print(
                "  OK"
            )

        else:

            print(
                "  ❌ Нет файла"
            )



print(
    "\n✅ Загрузка завершена"
)
