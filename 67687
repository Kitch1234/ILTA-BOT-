"""
Массовая генерация карт ILTA RPG
"""

import os
import random


from data.champion_loader import load_champions

from data.loot import get_card_rarity

from generators.card_generator import create_card



OUTPUT = "generated_cards"



def calculate_stats():

    return {

        "attack": random.randint(
            20,
            100
        ),

        "health": random.randint(
            50,
            150
        ),

        "defense": random.randint(
            10,
            80
        )

    }





def generate_all():


    champions = load_champions()


    if not champions:

        print(
            "❌ Чемпионы не найдены"
        )

        return



    total = 0



    for champion_id, data in champions.items():


        region = data.get(
            "region",
            "Runeterra"
        )



        skins = data.get(
            "skins",
            []
        )



        for skin in skins:


            skin_name = skin["name"]

            image_path = skin["file"]



            if not os.path.exists(
                image_path
            ):

                print(
                    "❌ Нет файла:",
                    image_path
                )

                continue



            stats = calculate_stats()



            rarity = get_card_rarity()



            card_code = (
                f"{random.randint(1,9999):04}"
            )



            card = create_card(

                champion=champion_id,

                skin=skin_name,

                rarity=rarity,

                region=region,

                attack=stats["attack"],

                health=stats["health"],

                defense=stats["defense"],

                image_path=image_path,

                card_number=card_code

            )



            total += 1



            print(
                "✅ Создана:",
                card
            )



    print(
        f"\n🎴 Всего карт создано: {total}"
    )





if __name__ == "__main__":

    generate_all()
