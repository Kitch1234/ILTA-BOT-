"""
Массовая генерация карт ILTA RPG
"""

import os
import sys
import random


# добавляем корень проекта в путь
ROOT = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

sys.path.append(ROOT)



from data.champion_loader import load_champions
from data.loot import get_card_rarity

from generators.card_generator import create_card



OUTPUT = "generated_cards"



def calculate_stats():

    return {

        "attack": random.randint(
            20,
            100
        ),

        "health": random.randint(
            50,
            150
        ),

        "defense": random.randint(
            10,
            80
        )

    }





def generate_all():


    champions = load_champions()


    if not champions:

        print(
            "❌ Чемпионы не найдены"
        )

        return



    total = 0


    for champion_name, data in champions.items():


        region = data.get(
            "region",
            "Runeterra"
        )


        skins = data.get(
            "skins",
            []
        )



        for skin in skins:


            image_path = skin["file"]


            skin_name = skin["name"]



            if not os.path.exists(
                image_path
            ):

                print(
                    "❌ Нет картинки:",
                    image_path
                )

                continue



            stats = calculate_stats()



            rarity = get_card_rarity()



            card_number = (
                f"{random.randint(1,9999):04}"
            )



            print(
                f"🎴 {champion_name} | {skin_name}"
            )



            file = create_card(

                champion=champion_name,

                skin=skin_name,

                rarity=rarity,

                region=region,

                attack=stats["attack"],

                health=stats["health"],

                defense=stats["defense"],

                image_path=image_path,

                card_number=card_number

            )


            total += 1


            print(
                "✅ Создано:",
                file
            )



    print(
        f"\n🌟 Всего карт создано: {total}"
    )





if __name__ == "__main__":

    generate_all()
