import os
import requests


CHAMPIONS_PATH = "assets/champions"


BASE_URL = (
    "https://raw.communitydragon.org/"
    "latest/plugins/rcp-be-lol-game-data/global/default/v1/champion-icons/"
)


def download_image(url, path):

    try:

        r = requests.get(
            url,
            timeout=20
        )

        if r.status_code != 200:
            return False


        with open(
            path,
            "wb"
        ) as f:

            f.write(
                r.content
            )


        return True


    except Exception as e:

        print(e)

        return False



def scan_champions():

    champions = []


    for region in os.listdir(CHAMPIONS_PATH):

        region_path = os.path.join(
            CHAMPIONS_PATH,
            region
        )


        if not os.path.isdir(region_path):
            continue



        for champion in os.listdir(region_path):

            champion_path = os.path.join(
                region_path,
                champion
            )


            if os.path.isdir(champion_path):

                champions.append(
                    champion
                )


    return champions




def main():

    champions = scan_champions()


    print(
        f"Найдено чемпионов: {len(champions)}"
    )


    for champion in champions:


        print(
            "Обработка:",
            champion
        )


        # пока тестовый вариант
        # создаём папку

        print(
            "Готов:"
            ,
            champion
        )



if __name__ == "__main__":

    main()
