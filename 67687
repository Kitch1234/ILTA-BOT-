import json
import os


FILE = "data/champions.json"


# Riot Champion IDs
CHAMPION_IDS = {

    "Aatrox": 266,
    "Ahri": 103,
    "Akali": 84,
    "Akshan": 166,
    "Alistar": 12,
    "Amumu": 32,
    "Anivia": 34,
    "Annie": 1,
    "Aphelios": 523,
    "Ashe": 22,

    "Darius": 122,
    "Draven": 119,
    "Katarina": 55,
    "Kled": 240,
    "LeBlanc": 7,
    "Mordekaiser": 82,
    "Riven": 92,
    "Samira": 360,
    "Sion": 14,
    "Swain": 50,
    "Talon": 91,
    "Vladimir": 8,

    "Fiora": 114,
    "Garen": 86,
    "JarvanIV": 59,
    "Jarvan IV": 59,
    "Lux": 99,
    "Lucian": 236,
    "Quinn": 133,
    "Shyvana": 102,
    "Sona": 37,
    "Sylas": 517,
    "XinZhao": 5,
    "Xin Zhao": 5
}



def main():

    if not os.path.exists(FILE):

        print(
            "❌ Не найден:",
            FILE
        )

        return



    with open(
        FILE,
        "r",
        encoding="utf-8"
    ) as f:

        data = json.load(f)



    updated = 0



    for champion, info in data.items():


        if champion in CHAMPION_IDS:

            info["id"] = CHAMPION_IDS[champion]

            updated += 1

            print(
                "✔",
                champion,
                "→",
                CHAMPION_IDS[champion]
            )

        else:

            print(
                "⚠ Нет ID:",
                champion
            )



    with open(
        FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            data,
            f,
            ensure_ascii=False,
            indent=4
        )



    print()
    print(
        f"✅ Обновлено чемпионов: {updated}"
    )



if __name__ == "__main__":

    main()
