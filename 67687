from PIL import Image, ImageDraw, ImageFont
import os


# =====================================
# НАСТРОЙКИ
# =====================================

CARD_WIDTH = 1064
CARD_HEIGHT = 1478


ASSETS = "assets"

OUTPUT = "generated_cards"



# =====================================
# КЭШИ
# =====================================

FONT_CACHE = {}

FRAME_CACHE = {}

REGION_CACHE = {}

ART_CACHE = {}



# =====================================
# ШРИФТЫ
# =====================================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =====================================
# РАМКИ
# =====================================

FRAME_PATHS = {

    "Обычный": "common.png",

    "Редкий": "rare.png",

    "Эпический": "epic.png",

    "Легендарный": "legendary.png",

    "Мифический": "mythic.png",

    "Престижный": "prestige.png",

    "Чемпионский": "ultimate.png"

}



# =====================================
# РЕГИОНЫ
# =====================================

REGION_ICONS = {

    "Демасия": "Demacia.png",

    "Ноксус": "Noxus.png"

}


REGION_PATH = os.path.join(

    ASSETS,

    "regions"

)



# =====================================
# АРТ
# =====================================

ART_WIDTH = 990

ART_HEIGHT = 1000


ART_X = (

    CARD_WIDTH - ART_WIDTH

) // 2


ART_Y = 35



# =====================================
# ПОЗИЦИИ ТЕКСТА
# =====================================

CARD_LAYOUT = {

    "number": (900, 80),

    "champion": (532, 1160),

    "skin": (532, 1220),

    "attack": (250, 1340),

    "health": (530, 1340),

    "defense": (810, 1340),

    "ability": (532, 1405)

}
# =====================================
# ШРИФТЫ
# =====================================

def get_font(path, size):

    key = (
        path,
        size
    )


    if key not in FONT_CACHE:

        FONT_CACHE[key] = ImageFont.truetype(

            path,

            size

        )


    return FONT_CACHE[key]





# =====================================
# РАМКА
# =====================================

def get_frame(rarity):


    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )



    if path not in FRAME_CACHE:


        if not os.path.exists(path):

            return None



        frame = Image.open(

            path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (

                CARD_WIDTH,

                CARD_HEIGHT

            ),

            Image.LANCZOS

        )


        FRAME_CACHE[path] = frame



    return FRAME_CACHE[path]





# =====================================
# ИКОНКА РЕГИОНА
# =====================================

def get_region_icon(region):


    icon_name = REGION_ICONS.get(

        region

    )


    if not icon_name:

        return None



    path = os.path.join(

        REGION_PATH,

        icon_name

    )



    if path not in REGION_CACHE:


        if not os.path.exists(path):

            return None



        icon = Image.open(

            path

        ).convert(

            "RGBA"

        )


        icon = icon.resize(

            (

                80,

                80

            ),

            Image.LANCZOS

        )


        REGION_CACHE[path] = icon



    return REGION_CACHE[path]





# =====================================
# ПОДГОТОВКА АРТА
# =====================================

def prepare_art(image):


    ratio = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    image = image.resize(

        (

            int(image.width * ratio),

            int(image.height * ratio)

        ),

        Image.LANCZOS

    )


    left = (

        image.width - ART_WIDTH

    ) // 2



    top = (

        image.height - ART_HEIGHT

    ) // 2



    return image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )





# =====================================
# АРТ С КЭШЕМ
# =====================================

def get_art(path):


    if path not in ART_CACHE:


        image = Image.open(

            path

        ).convert(

            "RGBA"

        )


        ART_CACHE[path] = prepare_art(

            image

        )



    return ART_CACHE[path]
# =====================================
# ТЕКСТ ПО ЦЕНТРУ
# =====================================

def draw_center_text(

    draw,

    position,

    text,

    size,

    bold=True

):


    font = get_font(

        FONT_BOLD if bold else FONT_REGULAR,

        size

    )


    box = draw.textbbox(

        (
            0,
            0
        ),

        text,

        font=font

    )


    width = box[2] - box[0]


    x = position[0] - width // 2



    # тень

    draw.text(

        (
            x + 3,
            position[1] + 3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )



    # основной текст

    draw.text(

        (
            x,
            position[1]
        ),

        text,

        font=font,

        fill=(255,255,255)

    )





# =====================================
# СОЗДАНИЕ КАРТЫ
# =====================================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    ability,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    # =============================
    # ПОЛОТНО
    # =============================

    card = Image.new(

        "RGBA",

        (

            CARD_WIDTH,

            CARD_HEIGHT

        ),

        (

            0,

            0,

            0,

            0

        )

    )



    # =============================
    # АРТ
    # =============================

    art = get_art(

        image_path

    )


    card.alpha_composite(

        art,

        (

            ART_X,

            ART_Y

        )

    )



    # =============================
    # РАМКА
    # =============================

    frame = get_frame(

        rarity

    )


    if frame:

        card.alpha_composite(

            frame

        )



    # =============================
    # РЕГИОН
    # =============================

    region_icon = get_region_icon(

        region

    )


    if region_icon:

        card.alpha_composite(

            region_icon,

            (

                50,

                50

            )

        )



    draw = ImageDraw.Draw(

        card

    )



    # =============================
    # НОМЕР
    # =============================

    draw_center_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        34

    )



    # =============================
    # ЧЕМПИОН
    # =============================

    draw_center_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        52

    )



    # =============================
    # СКИН
    # =============================

    if skin and skin.lower() != "default":


        draw_center_text(

            draw,

            CARD_LAYOUT["skin"],

            skin,

            34,

            False

        )



    # =============================
    # СТАТЫ
    # =============================

    draw_center_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )
    # =============================
    # СПОСОБНОСТЬ
    # =============================

    if ability:


        draw_center_text(

            draw,

            CARD_LAYOUT["ability"],

            ability,

            28,

            False

        )



    # =============================
    # СОХРАНЕНИЕ
    # =============================

    filename = (

        f"{champion}_{card_number}.png"

    )


    filename = filename.replace(

        " ",

        "_"

    )



    path = os.path.join(

        OUTPUT,

        filename

    )



    # быстрое сохранение

    card.save(

        path,

        optimize=False,

        compress_level=1

    )



    return path
