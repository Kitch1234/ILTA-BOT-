from PIL import Image, ImageDraw, ImageFont
import os


# =========================
# РАЗМЕР КАРТЫ
# =========================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"

OUTPUT = "generated_cards"



# =========================
# ШРИФТЫ
# =========================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)

FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =========================
# РАМКИ
# =========================

FRAME_PATHS = {

    "Обычный": "common.png",
    "Редкий": "rare.png",
    "Эпический": "epic.png",
    "Легендарный": "legendary.png",
    "Мифический": "mythic.png"

}



# =========================
# КООРДИНАТЫ
# =========================

CARD_LAYOUT = {

    "number": (900, 90),

    "champion_y": 1010,

    "skin_y": 1080,

    "attack": (250, 1210),

    "health": (530, 1210),

    "defense": (810, 1210),

    "region_text": (250, 1380),

    "rarity": (820, 1380)

}



# =========================
# ФОНТ
# =========================

def get_font(path, size):

    return ImageFont.truetype(
        path,
        size
    )



# =========================
# ЦЕНТРИРОВАННЫЙ ТЕКСТ
# =========================

def draw_center_text(
    draw,
    y,
    text,
    size,
    bold=True
):

    font = get_font(
        FONT_BOLD if bold else FONT_REGULAR,
        size
    )


    box = draw.textbbox(
        (0,0),
        text,
        font=font
    )


    width = box[2] - box[0]


    x = (
        CARD_WIDTH - width
    ) // 2



    # тень

    draw.text(

        (
            x + 3,
            y + 3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )


    # текст

    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )



# =========================
# ОСТАЛЬНОЙ ТЕКСТ
# =========================

def draw_text(
    draw,
    position,
    text,
    size
):

    font = get_font(
        FONT_BOLD,
        size
    )


    x,y = position


    draw.text(

        (
            x+3,
            y+3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )


    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )



# =========================
# ОБРЕЗКА АРТА
# =========================

def fit_image(
    image,
    size,
    zoom=1.60
):

    target_w, target_h = size


    ratio = max(

        target_w / image.width,

        target_h / image.height

    )


    ratio *= zoom



    image = image.resize(

        (

            int(image.width * ratio),

            int(image.height * ratio)

        ),

        Image.LANCZOS

    )


    left = (

        image.width - target_w

    ) // 2



    top = (

        image.height - target_h

    ) // 2



    return image.crop(

        (

            left,

            top,

            left + target_w,

            top + target_h

        )

    )



# =========================
# СОЗДАНИЕ КАРТЫ
# =========================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(
        OUTPUT,
        exist_ok=True
    )



    card = Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,0)

    )



    # =====================
    # АРТ
    # =====================

    art = Image.open(
        image_path
    ).convert(
        "RGBA"
    )



    art = fit_image(

        art,

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        1.60

    )



    card.alpha_composite(
        art
    )



    # =====================
    # РАМКА
    # =====================

    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )



    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )


    if os.path.exists(frame_path):

        frame = Image.open(
            frame_path
        ).convert(
            "RGBA"
        )


        frame = frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            ),

            Image.LANCZOS

        )


        card.alpha_composite(
            frame
        )



    draw = ImageDraw.Draw(
        card
    )



    # =====================
    # ТЕКСТ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        36

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["champion_y"],

        champion,

        54

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["skin_y"],

        skin,

        38,

        False

    )



    # =====================
    # СТАТЫ
    # =====================

    draw_text(
        draw,
        CARD_LAYOUT["attack"],
        str(attack),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["health"],
        str(health),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["defense"],
        str(defense),
        50
    )



    draw_text(
        draw,
        CARD_LAYOUT["region_text"],
        region,
        34
    )


    draw_text(
        draw,
        CARD_LAYOUT["rarity"],
        rarity,
        34
    )



    # =====================
    # СОХРАНЕНИЕ
    # =====================

    filename = (

        f"{champion}_{skin}_{card_number}.png"

    ).replace(
        " ",
        "_"
    )


    path = os.path.join(
        OUTPUT,
        filename
    )


    card.save(
        path
    )


    return path
