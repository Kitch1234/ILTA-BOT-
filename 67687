import os
import re


CHAMPIONS_PATH = "assets/champions"


IMAGE_EXTENSIONS = (
    ".png",
    ".jpg",
    ".jpeg",
    ".webp"
)



def clean_skin_name(
    champion,
    name
):

    name = os.path.splitext(
        name
    )[0]


    name = (
        name
        .replace("_", " ")
        .replace("-", " ")
    )


    # убрать loading 308

    name = re.sub(
        r"\s*loading\s*\d+",
        "",
        name,
        flags=re.I
    )


    words = name.split()


    # убрать повтор чемпиона

    if words:

        if words[0].lower() == champion.lower():

            words = words[1:]


    # убрать повтор чемпиона в конце

    if words:

        if words[-1].lower() == champion.lower():

            words = words[:-1]


    name = " ".join(words)


    return name.strip()





def load_champions():

    champions = {}


    if not os.path.exists(
        CHAMPIONS_PATH
    ):

        print(
            "❌ Папка assets/champions не найдена"
        )

        return champions




    for region in sorted(
        os.listdir(CHAMPIONS_PATH)
    ):


        region_path = os.path.join(
            CHAMPIONS_PATH,
            region
        )


        if not os.path.isdir(
            region_path
        ):

            continue





        for champion in sorted(
            os.listdir(region_path)
        ):


            champion_path = os.path.join(
                region_path,
                champion
            )


            if not os.path.isdir(
                champion_path
            ):

                continue



            skins = []



            for image in sorted(
                os.listdir(champion_path)
            ):


                if not image.lower().endswith(
                    IMAGE_EXTENSIONS
                ):

                    continue



                skin_name = clean_skin_name(
                    champion,
                    image
                )



                skins.append({

                    "name": skin_name,

                    "file": os.path.join(
                        champion_path,
                        image
                    )

                })



            if not skins:

                continue




            champions[champion] = {

                "region": region,

                "skins": skins

            }



            print(
                f"✅ {region}: {champion} ({len(skins)} скинов)"
            )



    print(
        f"\n🌟 Загружено чемпионов: {len(champions)}"
    )


    return champions
