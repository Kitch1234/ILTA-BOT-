# =========================

def get_font(path, size):

    return ImageFont.truetype(

        path,

        size

    )



def draw_text(

    draw,

    position,

    text,

    size,

    bold=True

):

    font = get_font(

        FONT_BOLD if bold else FONT_REGULAR,

        size

    )


    x, y = position


    draw.text(

        (
            x + 3,
            y + 3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )


    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )



# =========================
# ПОДГОТОВКА АРТА
# =========================

def prepare_art(image, champion):


    image = image.convert(

        "RGBA"

    )


    ratio = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    new_size = (

        int(image.width * ratio),

        int(image.height * ratio)

    )


    image = image.resize(

        new_size,

        Image.LANCZOS

    )


    focus = ART_FOCUS.get(

        champion,

        DEFAULT_FOCUS

    )


    left = (

        image.width - ART_WIDTH

    ) // 2



    top = int(

        (image.height - ART_HEIGHT) * focus

    )



    image = image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )


    return image
