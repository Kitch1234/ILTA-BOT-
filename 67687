import os
import json
import requests



# ==================================
# НАСТРОЙКИ
# ==================================

VERSION = "16.14.1"


DATA_DRAGON = (
    f"https://ddragon.leagueoflegends.com/cdn/{VERSION}/data/en_US/champion/"
)


CHAMPION_PATH = "assets/champions"


OUTPUT = "data/skins.json"





# ==================================
# СОЗДАНИЕ ПАПКИ
# ==================================

os.makedirs(
    "data",
    exist_ok=True
)





# ==================================
# ПОЛУЧИТЬ JSON ЧЕМПИОНА
# ==================================

def get_champion_data(champion):


    url = DATA_DRAGON + champion + ".json"


    response = requests.get(
        url
    )


    if response.status_code != 200:

        print(
            "Ошибка:",
            champion
        )

        return None



    return response.json()





# ==================================
# СОЗДАТЬ БАЗУ СКИНОВ
# ==================================

def extract():


    skins = {}



    for region in os.listdir(CHAMPION_PATH):


        region_path = os.path.join(

            CHAMPION_PATH,

            region

        )


        if not os.path.isdir(region_path):

            continue




        for champion in os.listdir(region_path):


            champion_path = os.path.join(

                region_path,

                champion

            )


            if not os.path.isdir(champion_path):

                continue



            print(
                "Проверяю:",
                champion
            )



            data = get_champion_data(

                champion

            )



            if not data:

                continue



            champ = data["data"][champion]



            for skin in champ["skins"]:


                num = skin["num"]


                skin_id = (

                    f"{champion}_{num}"

                )



                # пропускаем хромы

                if skin.get(

                    "chromas",

                    False

                ):

                    continue



                # проверяем наличие картинки

                found = False



                for file in os.listdir(champion_path):


                    name = os.path.splitext(

                        file

                    )[0]



                    if name == skin_id:

                        found = True

                        break



                if not found:

                    continue




                skins[skin_id] = {


                    "champion": champion,


                    "region": region,


                    "name": skin["name"],


                    "num": num

                }




    return skins





# ==================================
# ЗАПУСК
# ==================================

if __name__ == "__main__":


    result = extract()



    with open(

        OUTPUT,

        "w",

        encoding="utf-8"

    ) as f:


        json.dump(

            result,

            f,

            ensure_ascii=False,

            indent=4

        )



    print()

    print(
        "✅ Создано скинов:",
        len(result)
    )
