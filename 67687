import requests


VERSION = "16.14.1"


url = (
    f"https://ddragon.leagueoflegends.com/cdn/"
    f"{VERSION}/data/ru_RU/champion/Garen.json"
)


response = requests.get(url)


print(response.status_code)


data = response.json()


garen = data["data"]["Garen"]


print(
    "Чемпион:",
    garen["name"]
)


for skin in garen["skins"]:

    print(
        skin["num"],
        skin["name"]
    )
