import discord
from discord.ext import commands
from discord import app_commands

import random
import os


from database.cards import add_card

from data.champion_loader import load_champions
from data.loot import get_card_rarity

from data.translations import (
    get_champion_name
)

from views.skin_view import SkinView



class Pack(commands.Cog):


    def __init__(self, bot):

        self.bot = bot

        self.champions = load_champions()



    @app_commands.command(
        name="open_pack",
        description="Открыть ILTA Pack (3 карты)"
    )
    async def open_pack(
        self,
        interaction: discord.Interaction
    ):


        await interaction.response.defer()



        if not self.champions:

            await interaction.followup.send(
                "❌ Нет доступных чемпионов"
            )

            return



        await interaction.followup.send(

            f"🎁 **{interaction.user.name} открыл ILTA Pack (3 карты)**"

        )



        for number in range(1,4):


            # =====================
            # ЧЕМПИОН
            # =====================

            champion_id = random.choice(

                list(
                    self.champions.keys()
                )

            )


            champion = self.champions[champion_id]



            region = champion.get(

                "region",

                "Runeterra"

            )



            skins = champion.get(

                "skins",

                []

            )


            if not skins:

                continue



            # =====================
            # ВСЕ СКИНЫ
            # =====================

            skin_list = skins.copy()



            first_skin = random.choice(

                skin_list

            )



            # =====================
            # НАЗВАНИЕ
            # =====================

            champion_name = get_champion_name(

                champion_id

            )



            # =====================
            # РЕДКОСТЬ
            # =====================

            rarity = get_card_rarity()



            # =====================
            # СТАТЫ
            # =====================

            attack = random.randint(
                20,
                100
            )


            health = random.randint(
                50,
                150
            )


            defense = random.randint(
                10,
                80
            )



            # =====================
            # ID
            # =====================

            card_code = (

                f"{random.randint(1,9999):04}"

            )



            # =====================
            # СОХРАНЕНИЕ
            # =====================

            await add_card(

                interaction.user.id,

                card_code,

                champion_id,

                first_skin["name"],

                region,

                rarity,

                attack,

                defense,

                health

            )



            # =====================
            # VIEW
            # =====================

            view = SkinView(

                cards=skin_list,

                champion_data=champion,

                champion_name=champion_name,

                region=region,

                rarity=rarity,

                attack=attack,

                health=health,

                defense=defense,

                card_number=card_code

            )



            # первая карта

            file_path = view.cards[0]["file"]



            from generators.card_generator import create_card



            generated = create_card(

                champion=champion_name,

                skin=first_skin["name"],

                rarity=rarity,

                region=region,

                attack=attack,

                health=health,

                defense=defense,

                image_path=file_path,

                card_number=card_code

            )



            file = discord.File(

                generated

            )



            embed = discord.Embed(

                title=(

                    f"🎴 {rarity} | {champion_name}"

                ),

                description=(

                    f"✨ {first_skin['name']}\n"

                    f"🆔 {card_code}"

                ),

                color=0xFFD700

            )



            embed.add_field(

                name="⚔ Атака",

                value=str(attack),

                inline=True

            )


            embed.add_field(

                name="❤️ Здоровье",

                value=str(health),

                inline=True

            )


            embed.add_field(

                name="🛡 Защита",

                value=str(defense),

                inline=True

            )


            embed.add_field(

                name="🌍 Регион",

                value=region,

                inline=True

            )


            embed.set_image(

                url=

                f"attachment://{file.filename}"

            )


            embed.set_footer(

                text=f"Карта {number}/3 | ◀️ ▶️ Скины"

            )



            await interaction.followup.send(

                embed=embed,

                file=file,

                view=view

            )




async def setup(bot):

    await bot.add_cog(

        Pack(bot)

    )
