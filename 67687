def get_region_icon(region):

    icon_name = REGION_ICONS.get(region)

    if not icon_name:
        return None

    path = os.path.join(REGION_PATH, icon_name)

    if path not in REGION_CACHE:

        if not os.path.exists(path):
            return None

        icon = Image.open(path).convert("RGBA")
        icon = icon.resize((REGION_ICON_SIZE, REGION_ICON_SIZE), Image.LANCZOS)

        REGION_CACHE[path] = icon

    return REGION_CACHE[path]



