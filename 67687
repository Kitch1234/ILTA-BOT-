import discord
from discord.ext import commands
from discord import app_commands

class Changelog(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @app_commands.command(
        name="changelog",
        description="Отправить changelog в чат"
    )
    async def changelog(self, interaction: discord.Interaction):
        text = (
            "# 📜 ILTA BOT — Обновление v0.1.0\n\n"
            "## ✨ Новое\n"
            "• Добавлена система Королевства.\n"
            "• Добавлены Дома игроков.\n\n"
            "## ⚖️ Изменения\n"
            "• Обновлён интерфейс.\n\n"
            "## 🛠️ Исправления\n"
            "• Исправлены ошибки открытия паков."
        )

        await interaction.response.send_message("✅ Changelog отправлен.", ephemeral=True)
        await interaction.channel.send(text)

async def setup(bot):
    await bot.add_cog(Changelog(bot))
