import os
import json
import requests


CHAMPIONS_JSON = "data/champions.json"

ASSETS_PATH = "assets/champions"


REGIONS = [
    "Demacia",
    "Noxus"
]


CDRAGON_URL = (
    "https://raw.communitydragon.org/latest/"
    "plugins/rcp-be-lol-game-data/global/default/"
    "v1/champion/{champion_id}/skins/{skin_id}.jpg"
)



def download(url, path):

    try:

        response = requests.get(
            url,
            timeout=30
        )


        if response.status_code != 200:

            print(
                "❌ Не найден:",
                url
            )

            return False



        with open(
            path,
            "wb"
        ) as file:

            file.write(
                response.content
            )


        return True



    except Exception as e:

        print(
            "Ошибка:",
            e
        )

        return False





def main():


    with open(
        CHAMPIONS_JSON,
        "r",
        encoding="utf-8"
    ) as file:

        champions = json.load(file)



    total = 0



    for region in REGIONS:


        region_path = os.path.join(
            ASSETS_PATH,
            region
        )


        if not os.path.exists(region_path):

            continue



        for folder in os.listdir(region_path):


            if folder not in champions:

                continue



            champion = champions[folder]


            champion_id = champion.get(
                "id"
            )


            if not champion_id:

                print(
                    "Нет ID:",
                    folder
                )

                continue



            champion_path = os.path.join(
                region_path,
                folder
            )



            os.makedirs(
                champion_path,
                exist_ok=True
            )



            print()
            print(
                "====",
                folder,
                "===="
            )



            for skin in champion.get("skins", []):


                skin_id = skin["id"]

                skin_name = skin["name"]


                filename = (
                    skin_name
                    .replace(" ", "_")
                    .replace("/", "_")
                    + ".jpg"
                )



                save_path = os.path.join(
                    champion_path,
                    filename
                )



                if os.path.exists(save_path):

                    print(
                        "Есть:",
                        filename
                    )

                    continue



                url = CDRAGON_URL.format(

                    champion_id=champion_id,

                    skin_id=skin_id

                )



                print(
                    "Скачивание:",
                    skin_name
                )



                if download(
                    url,
                    save_path
                ):

                    total += 1

                    print(
                        "✔ Готово"
                    )



    print()
    print(
        "Всего скачано:",
        total
    )




if __name__ == "__main__":

    main()
