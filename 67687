Координаты интерфейса коллекции ILTA
"""

# =====================================
# Размер изображения
# =====================================

IMAGE_WIDTH = 1536
IMAGE_HEIGHT = 1024

# =====================================
# Размер карты
# =====================================

CARD_WIDTH = 260
CARD_HEIGHT = 380

# =====================================
# Сетка карт
# =====================================

CARDS_PER_ROW = 3
ROWS = 2

START_X = 170
START_Y = 190

GAP_X = 65
GAP_Y = 48

CARD_POSITIONS = []

TOP_ROW_OFFSET = 10        # верхний ряд вниз
BOTTOM_ROW_OFFSET = 20    # нижний ряд вниз

for row in range(ROWS):
    for col in range(CARDS_PER_ROW):

        x = START_X + col * (CARD_WIDTH + GAP_X)
        y = START_Y + row * (CARD_HEIGHT + GAP_Y)

        if row == 0:
            y += TOP_ROW_OFFSET

        if row == 1:
            y += BOTTOM_ROW_OFFSET

        CARD_POSITIONS.append((x, y))


