# =====================================
# ПОДГОТОВКА АРТА
# =====================================

def prepare_art(image):

    image = image.resize(

        (
            ART_WIDTH,
            ART_HEIGHT
        ),

        Image.LANCZOS
    )

    return image





# =====================================
# АРТ С КЭШЕМ
# =====================================

def get_art(path):

    if path not in ART_CACHE:

        image = Image.open(
            path
        ).convert(
            "RGBA"
        )

        ART_CACHE[path] = prepare_art(
            image
        )

    return ART_CACHE[path]
