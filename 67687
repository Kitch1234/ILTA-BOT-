import json
import os

CARDS_PATH = os.path.join(
    os.path.dirname(__file__),
    "cards.json"
)

_cards = None


def load_cards():
    """
    Загружает cards.json один раз.
    """

    global _cards

    if _cards is None:

        with open(
            CARDS_PATH,
            "r",
            encoding="utf-8"
        ) as f:

            _cards = json.load(f)

    return _cards


def get_card(card_id):
    """
    Получить карту по ID.
    """

    cards = load_cards()

    return cards.get(card_id)


def get_random_card():
    """
    Получить случайную карту.
    """

    import random

    cards = list(load_cards().values())

    return random.choice(cards)


def get_cards_by_region(region):
    """
    Все карты региона.
    """

    cards = []

    for card in load_cards().values():

        if card["region"] == region:

            cards.append(card)

    return cards


