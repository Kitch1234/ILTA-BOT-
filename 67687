from PIL import Image, ImageDraw, ImageFont
import os


# =====================================
# НАСТРОЙКИ
# =====================================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"

OUTPUT = "generated_cards"



# =====================================
# КЭШИ
# =====================================

FONT_CACHE = {}

FRAME_CACHE = {}

REGION_CACHE = {}

ART_CACHE = {}





# =====================================
# ШРИФТЫ
# =====================================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)





# =====================================
# ЦВЕТА РЕДКОСТИ
# =====================================

RARITY_COLORS = {


    "Обычный":
        (220, 220, 220),


    "Редкий":
        (80, 180, 255),


    "Эпический":
        (180, 80, 255),


    "Легендарный":
        (255, 170, 40),


    "Мифический":
        (255, 70, 180),


    "Престижный":
        (255, 220, 80),


    "Чемпионский":
        (255, 80, 80)

}





# =====================================
# РАМКИ
# =====================================

FRAME_PATHS = {


    "Обычный":
        "common.png",


    "Редкий":
        "rare.png",


    "Эпический":
        "epic.png",


    "Легендарный":
        "legendary.png",


    "Мифический":
        "mythic.png",


    "Престижный":
        "prestige.png",


    "Чемпионский":
        "ultimate.png"

}





# =====================================
# РЕГИОНЫ
# =====================================

REGION_ICONS = {


    "Демасия":
        "Demacia.png",


    "Ноксус":
        "Noxus.png"

}


REGION_PATH = os.path.join(
    ASSETS,
    "regions"
)





# =====================================
# АРТ
# =====================================

ART_WIDTH = 870

ART_HEIGHT = 710


ART_X = (
    CARD_WIDTH - ART_WIDTH
) // 2


ART_Y = 185
# =====================================
# ПОЗИЦИИ ЭЛЕМЕНТОВ
# =====================================

CARD_LAYOUT = {


    # номер карты

    "number": (

        900,

        90

    ),



    # чемпион

    "champion": (

        530,

        1010

    ),



    # скин

    "skin": (

        530,

        1080

    ),



    # статы

    "attack": (

        250,

        1210

    ),


    "health": (

        530,

        1210

    ),


    "defense": (

        810,

        1210

    ),



    # способность

    "ability":

    (

        530,

        1320

    )

}





# =====================================
# ЗАГРУЗКА ШРИФТОВ
# =====================================

def get_font(

    path,

    size

):


    key = (

        path,

        size

    )


    if key not in FONT_CACHE:


        FONT_CACHE[key] = ImageFont.truetype(

            path,

            size

        )


    return FONT_CACHE[key]







# =====================================
# РАМКА
# =====================================

def get_frame(

    rarity

):


    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )



    if path not in FRAME_CACHE:


        if not os.path.exists(path):

            return None



        frame = Image.open(

            path

        ).convert(

            "RGBA"

        )



        frame = frame.resize(

            (

                CARD_WIDTH,

                CARD_HEIGHT

            ),

            Image.LANCZOS

        )



        FRAME_CACHE[path] = frame



    return FRAME_CACHE[path]







# =====================================
# ИКОНКА РЕГИОНА
# =====================================

def get_region_icon(

    region

):


    icon_name = REGION_ICONS.get(

        region

    )


    if not icon_name:

        return None



    path = os.path.join(

        REGION_PATH,

        icon_name

    )



    if path not in REGION_CACHE:


        if not os.path.exists(path):

            return None



        icon = Image.open(

            path

        ).convert(

            "RGBA"

        )



        icon = icon.resize(

            (

                70,

                70

            ),

            Image.LANCZOS

        )



        REGION_CACHE[path] = icon



    return REGION_CACHE[path]
# =====================================
# ПОДГОТОВКА АРТА
# =====================================

def prepare_art(image):


    ratio = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    image = image.resize(

        (

            int(image.width * ratio),

            int(image.height * ratio)

        ),

        Image.LANCZOS

    )


    left = (

        image.width - ART_WIDTH

    ) // 2



    top = (

        image.height - ART_HEIGHT

    ) // 2



    return image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )





# =====================================
# АРТ С КЭШЕМ
# =====================================

def get_art(path):


    if path not in ART_CACHE:


        image = Image.open(

            path

        ).convert(

            "RGBA"

        )


        ART_CACHE[path] = prepare_art(

            image

        )



    return ART_CACHE[path]







# =====================================
# РАЗРЯДКА ТЕКСТА
# =====================================

def spaced_text(text, spacing=3):


    return " ".join(

        list(text)

    ) if spacing else text







# =====================================
# РИСОВАНИЕ ТЕКСТА ПО ЦЕНТРУ
# =====================================

def draw_center_text(

    draw,

    position,

    text,

    size,

    rarity="Обычный",

    bold=True,

    spacing=0

):


    if not text:

        return



    if spacing:

        text = spaced_text(

            text,

            spacing

        )



    font = get_font(

        FONT_BOLD if bold else FONT_REGULAR,

        size

    )



    # уменьшаем длинный текст

    while True:


        box = draw.textbbox(

            (0,0),

            text,

            font=font

        )


        width = box[2] - box[0]


        if width <= 850:

            break



        size -= 2


        font = get_font(

            FONT_BOLD if bold else FONT_REGULAR,

            size

        )



    x = position[0] - width // 2



    color = RARITY_COLORS.get(

        rarity,

        (255,255,255)

    )



    # тень

    draw.text(

        (

            x + 3,

            position[1] + 3

        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )



    # основной текст

    draw.text(

        (

            x,

            position[1]

        ),

        text,

        font=font,

        fill=color

    )





# =====================================
# МНОГОСТРОЧНАЯ СПОСОБНОСТЬ
# =====================================

def wrap_text(

    text,

    max_chars=35

):


    words = text.split()


    lines = []

    current = ""



    for word in words:


        if len(current) + len(word) + 1 <= max_chars:


            current += " " + word



        else:


            lines.append(

                current.strip()

            )


            current = word



    if current:

        lines.append(

            current.strip()

        )



    return lines
# =====================================
# СОЗДАНИЕ КАРТЫ
# =====================================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    ability,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    # =================================
    # ПОЛОТНО
    # =================================

    card = Image.new(

        "RGBA",

        (

            CARD_WIDTH,

            CARD_HEIGHT

        ),

        (

            0,

            0,

            0,

            0

        )

    )



    # =================================
    # АРТ
    # =================================

    art = get_art(

        image_path

    )


    card.alpha_composite(

        art,

        (

            ART_X,

            ART_Y

        )

    )





    # =================================
    # РАМКА
    # =================================

    frame = get_frame(

        rarity

    )


    if frame:

        card.alpha_composite(

            frame

        )





    # =================================
    # ИКОНКА РЕГИОНА
    # =================================

    region_icon = get_region_icon(

        region

    )


    if region_icon:


        card.alpha_composite(

            region_icon,

            (

                45,

                45

            )

        )





    draw = ImageDraw.Draw(

        card

    )





    # =================================
    # НОМЕР
    # =================================

    draw_center_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        30,

        rarity

    )





    # =================================
    # ЧЕМПИОН
    # =================================

    draw_center_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        42,

        rarity,

        True,

        2

    )





    # =================================
    # СКИН
    # =================================

    if skin and skin.lower() != "default":


        draw_center_text(

            draw,

            CARD_LAYOUT["skin"],

            skin,

            28,

            rarity,

            False

        )





    # =================================
    # СТАТЫ
    # =================================

    draw_center_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        42,

        rarity

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        42,

        rarity

    )


    draw_center_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        42,

        rarity

    )
    # =================================
    # СПОСОБНОСТЬ
    # =================================

    if ability:


        lines = wrap_text(

            ability,

            32

        )


        y = CARD_LAYOUT["ability"][1]


        for line in lines:


            draw_center_text(

                draw,

                (

                    CARD_LAYOUT["ability"][0],

                    y

                ),

                line,

                22,

                rarity,

                False

            )


            y += 35





    # =================================
    # СОХРАНЕНИЕ
    # =================================

    filename = (

        f"{champion}_{card_number}.png"

    )


    filename = filename.replace(

        " ",

        "_"

    )



    path = os.path.join(

        OUTPUT,

        filename

    )



    # =================================
    # ОПТИМИЗАЦИЯ
    # =================================

    card.save(

        path,

        "PNG",

        optimize=True,

        compress_level=9

    )



    return path
