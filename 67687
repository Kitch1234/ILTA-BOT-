from PIL import Image
import os


# Откуда брать centered арты
SOURCE = r"C:\Users\Ketek'\Desktop\img\champion\centered"


# Куда сохранять подготовленные арты
OUTPUT = "assets/champions_centered"



# Размер карты
TARGET_WIDTH = 1064
TARGET_HEIGHT = 1478



# Насколько отдалить персонажа
# 1.0 = оригинальный размер
# 0.85 = немного отдалить
# 0.75 = хорошо для карты
# 0.65 = сильно отдалить

ZOOM = 0.78



EXTENSIONS = (
    ".png",
    ".jpg",
    ".jpeg",
    ".webp"
)




def prepare():


    os.makedirs(
        OUTPUT,
        exist_ok=True
    )



    count = 0



    for file in os.listdir(SOURCE):


        if not file.lower().endswith(
            EXTENSIONS
        ):

            continue



        source_path = os.path.join(
            SOURCE,
            file
        )



        try:


            image = Image.open(
                source_path
            ).convert(
                "RGB"
            )



            # уменьшаем изображение для эффекта отдаления

            new_width = int(
                TARGET_WIDTH * ZOOM
            )


            new_height = int(
                TARGET_HEIGHT * ZOOM
            )



            image.thumbnail(
                (
                    new_width,
                    new_height
                ),
                Image.LANCZOS
            )



            # создаём холст карты

            canvas = Image.new(
                "RGB",
                (
                    TARGET_WIDTH,
                    TARGET_HEIGHT
                ),
                (0, 0, 0)
            )



            # центрируем арт

            x = (
                TARGET_WIDTH - image.width
            ) // 2



            y = (
                TARGET_HEIGHT - image.height
            ) // 2



            canvas.paste(
                image,
                (
                    x,
                    y
                )
            )



            save_path = os.path.join(
                OUTPUT,
                os.path.splitext(file)[0] + ".jpg"
            )



            canvas.save(
                save_path,
                "JPEG",
                quality=95,
                optimize=True
            )



            count += 1


            print(
                "✅",
                file
            )



        except Exception as e:


            print(
                "❌",
                file,
                e
            )



    print()

    print(
        f"🌟 Готово. Обработано артов: {count}"
    )





if __name__ == "__main__":

    prepare()
