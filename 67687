import os


CHAMPIONS_PATH = "assets/champions"


IMAGE_EXTENSIONS = (
    ".png",
    ".jpg",
    ".jpeg",
    ".webp"
)



def clean_name(name):

    return (
        name
        .replace("_", " ")
        .strip()
    )




def load_champions():

    champions = {}



    if not os.path.exists(CHAMPIONS_PATH):

        print(
            "❌ Нет папки assets/champions"
        )

        return {}



    for region in sorted(
        os.listdir(CHAMPIONS_PATH)
    ):


        region_path = os.path.join(
            CHAMPIONS_PATH,
            region
        )


        if not os.path.isdir(region_path):
            continue




        for champion_folder in sorted(
            os.listdir(region_path)
        ):


            champion_path = os.path.join(
                region_path,
                champion_folder
            )


            if not os.path.isdir(champion_path):
                continue



            skins = []



            for image in sorted(
                os.listdir(champion_path)
            ):


                if not image.lower().endswith(
                    IMAGE_EXTENSIONS
                ):
                    continue



                skin_name = os.path.splitext(
                    image
                )[0]



                skins.append({

                    "name": clean_name(
                        skin_name
                    ),

                    "file": os.path.join(
                        champion_path,
                        image
                    )

                })




            if not skins:
                continue




            champions[champion_folder] = {

                "name": clean_name(
                    champion_folder
                ),

                "region": region,

                "skins": skins

            }



            print(
                f"✅ {region}: {champion_folder} ({len(skins)} скинов)"
            )




    print(
        f"\n🌟 Чемпионов загружено: {len(champions)}"
    )


    return champions
