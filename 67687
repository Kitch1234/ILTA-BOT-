from PIL import Image, ImageDraw, ImageFont
import os
import textwrap


CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"
OUTPUT = "generated_cards"


FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)

FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



FRAME_PATHS = {

    "Обычный": "common.png",
    "Редкий": "rare.png",
    "Эпический": "epic.png",
    "Легендарный": "legendary.png",
    "Мифический": "mythic.png"

}



CARD_LAYOUT = {


    "number": (900,90),


    "champion": (530,1010),


    "skin": (530,1080),


    "attack": (250,1210),


    "health": (530,1210),


    "defense": (810,1210),


    "region": (250,1380),


    "rarity": (820,1380)

}




def get_font(path,size):

    return ImageFont.truetype(
        path,
        size
    )





def draw_text(
    draw,
    pos,
    text,
    size,
    bold=True
):

    font = get_font(
        FONT_BOLD if bold else FONT_REGULAR,
        size
    )


    x,y = pos


    draw.text(
        (x+3,y+3),
        text,
        font=font,
        fill=(0,0,0,220)
    )


    draw.text(
        (x,y),
        text,
        font=font,
        fill=(255,255,255)
    )





def fit_image(
    image,
    size,
    zoom=0.65
):

    target_w,target_h=size


    ratio = min(

        target_w / image.width,

        target_h / image.height

    )


    ratio *= zoom


    new_size=(

        int(image.width*ratio),

        int(image.height*ratio)

    )


    image=image.resize(
        new_size,
        Image.LANCZOS
    )


    canvas=Image.new(
        "RGBA",
        (
            target_w,
            target_h
        ),
        (0,0,0,0)
    )


    x=(target_w-image.width)//2
    y=(target_h-image.height)//2


    canvas.alpha_composite(
        image,
        (x,y)
    )


    return canvas





def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(
        OUTPUT,
        exist_ok=True
    )



    card=Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,0)

    )



    # арт

    art=Image.open(
        image_path
    ).convert(
        "RGBA"
    )


    art=fit_image(

        art,

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        zoom=0.65

    )


    card.alpha_composite(
        art
    )



    # рамка

    frame_file=FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path=os.path.join(

        ASSETS,

        "frames",

        frame_file

    )


    if os.path.exists(frame_path):

        frame=Image.open(
            frame_path
        ).convert(
            "RGBA"
        )


        frame=frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            )

        )


        card.alpha_composite(
            frame
        )



    draw=ImageDraw.Draw(
        card
    )



    draw_text(
        draw,
        CARD_LAYOUT["number"],
        f"#{card_number}",
        36
    )


    draw_text(
        draw,
        CARD_LAYOUT["champion"],
        champion,
        54
    )


    draw_text(
        draw,
        CARD_LAYOUT["skin"],
        skin,
        38,
        False
    )



    draw_text(
        draw,
        CARD_LAYOUT["attack"],
        str(attack),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["health"],
        str(health),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["defense"],
        str(defense),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["region"],
        region,
        34
    )


    draw_text(
        draw,
        CARD_LAYOUT["rarity"],
        rarity,
        34
    )



    filename=(

        f"{champion}_{skin}_{card_number}.png"

    ).replace(
        " ",
        "_"
    )


    path=os.path.join(

        OUTPUT,

        filename

    )


    card.save(
        path
    )


    return path
