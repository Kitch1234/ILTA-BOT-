import os
import re

FOLDER = "assets/champions"


def rename_image(name):
    filename, ext = os.path.splitext(name)

    # все разделители в _
    filename = filename.replace("-", "_")

    parts = filename.split("_")

    # имя чемпиона
    champion = parts[0].lower()

    # убрать имя чемпиона в начале
    parts = parts[1:]

    # убрать повтор имени чемпиона в конце
    while parts and parts[-1].lower() == champion:
        parts.pop()

    # убрать loading
    parts = [p for p in parts if p.lower() != "loading"]

    # убрать цифры
    parts = [p for p in parts if not p.isdigit()]

    # default -> Base
    if len(parts) == 1 and parts[0].lower() == "default":
        return "Base.webp"

    filename = "_".join(word.capitalize() for word in parts)

    return filename + ".webp"


def convert_and_rename(path):
    for root, dirs, files in os.walk(path):

        for file in files:

            if not file.lower().endswith(
                (".png", ".jpg", ".jpeg", ".webp")
            ):
                continue

            old = os.path.join(root, file)

            new_name = rename_image(file)

            new = os.path.join(root, new_name)

            if old == new:
                continue

            os.rename(old, new)

            print(f"✔ {file} → {new_name}")


convert_and_rename(FOLDER)

print("\n✅ Готово")
