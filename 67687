import json
import os
import random


# =====================================
# ПУТЬ К CARDS.JSON
# =====================================

CARDS_PATH = os.path.join(
    os.path.dirname(__file__),
    "cards.json"
)


# Кэш карт

_cards = None



# =====================================
# ЗАГРУЗКА КАРТ
# =====================================

def load_cards():

    global _cards


    if _cards is None:

        if not os.path.exists(CARDS_PATH):

            print(
                "❌ cards.json не найден"
            )

            return {}


        with open(

            CARDS_PATH,

            "r",

            encoding="utf-8"

        ) as file:

            _cards = json.load(file)



    return _cards





# =====================================
# ПОЛУЧИТЬ КАРТУ ПО ID
# =====================================

def get_card(card_id):

    cards = load_cards()


    return cards.get(

        card_id

    )





# =====================================
# СЛУЧАЙНАЯ КАРТА
# =====================================

def get_random_card():

    cards = list(

        load_cards().values()

    )


    if not cards:

        return None



    return random.choice(

        cards

    )





# =====================================
# КАРТЫ РЕГИОНА
# =====================================

def get_cards_by_region(region):

    result = []


    for card in load_cards().values():

        if card.get("region") == region:

            result.append(card)



    return result





