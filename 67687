def prepare_art(image):

    ratio = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    new_width = int(
        image.width * ratio
    )


    new_height = int(
        image.height * ratio
    )


    image = image.resize(

        (
            new_width,
            new_height
        ),

        Image.LANCZOS

    )


    left = (
        new_width - ART_WIDTH
    ) // 2


    top = (
        new_height - ART_HEIGHT
    ) // 2



    return image.crop(

        (
            left,
            top,
            left + ART_WIDTH,
            top + ART_HEIGHT
        )

    )
