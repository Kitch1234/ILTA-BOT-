# НАСТРОЙКИ
# =========================

REGIONS = [
    "Demacia",
    "Noxus"
]


CHAMPIONS_FILE = "data/champions.json"


OUTPUT = "assets/champions"



# CommunityDragon
CDN = "https://raw.communitydragon.org/latest/"



# =========================
# СЛОВАРЬ РЕГИОНОВ
# =========================

REGION_CHAMPIONS = {

    "Demacia": [
        "Fiora",
        "Galio",
        "Garen",
        "Jarvan IV",
        "Kayle",
        "Lucian",
        "Lux",
        "Morgana",
        "Poppy",
        "Quinn",
        "Senna",
