from PIL import Image, ImageDraw, ImageFont
import os



# =========================
# РАЗМЕР КАРТЫ
# =========================

CARD_WIDTH = 1064
CARD_HEIGHT = 1478


ASSETS = "assets"

OUTPUT = "generated_cards"



# =========================
# ШРИФТЫ
# =========================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =========================
# РАМКИ
# =========================

FRAME_PATHS = {

    "Обычный": "common.png",

    "Редкий": "rare.png",

    "Эпический": "epic.png",

    "Легендарный": "legendary.png",

    "Мифический": "mythic.png"

}



# =========================
# РЕДКОСТЬ
# =========================

RARITY_NAMES = {

    "Обычный": "COMMON",

    "Редкий": "RARE",

    "Эпический": "EPIC",

    "Легендарный": "LEGENDARY",

    "Мифический": "MYTHIC"

}



# =========================
# ОБЛАСТЬ АРТА
# =========================

ART_WIDTH = 953
ART_HEIGHT = 900


ART_X = (

    CARD_WIDTH - ART_WIDTH

) // 2


ART_Y = 55





# =========================
# ТЕКСТ
# =========================

CARD_LAYOUT = {

    "number": (900,80),

    "champion": (532,1180),

    "skin": (532,1240),

    "attack": (250,1340),

    "health": (530,1340),

    "defense": (810,1340),

    "region": (250,1420),

    "rarity": (820,1420)

}



# =========================
# ФОНТ
# =========================

def get_font(path, size):

    return ImageFont.truetype(

        path,

        size

    )



def draw_text(

    draw,

    position,

    text,

    size,

    bold=True

):

    font = get_font(

        FONT_BOLD if bold else FONT_REGULAR,

        size

    )


    x, y = position


    draw.text(

        (
            x + 3,
            y + 3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )


    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )



# =========================
# ПОДГОТОВКА АРТА
# =========================

def prepare_art(image):

    image = image.convert(
        "RGBA"
    )


    ratio = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    new_size = (

        int(image.width * ratio),

        int(image.height * ratio)

    )


    image = image.resize(

        new_size,

        Image.LANCZOS

    )


    # сдвиг кадра вверх,
    # чтобы сохранить низ изображения

    top = int(

        (image.height - ART_HEIGHT) * 0.35

    )


    left = (

        image.width - ART_WIDTH

    ) // 2


    image = image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )


    return image
# =========================
# СОЗДАНИЕ КАРТЫ
# =========================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    card = Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,0)

    )



    # =====================
    # АРТ
    # =====================

    art = Image.open(

        image_path

    ).convert(

        "RGBA"

    )


    art = prepare_art(

        art

    )


    card.alpha_composite(

        art,

        (
            ART_X,
            ART_Y
        )

    )



    # =====================
    # РАМКА
    # =====================

    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )


    if os.path.exists(frame_path):


        frame = Image.open(

            frame_path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            ),

            Image.LANCZOS

        )


        card.alpha_composite(

            frame

        )



    draw = ImageDraw.Draw(

        card

    )



    # =====================
    # ТЕКСТ
    # =====================


    draw_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        36

    )


    draw_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        54

    )


    draw_text(

        draw,

        CARD_LAYOUT["skin"],

        skin,

        38,

        False

    )


    draw_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["region"],

        region,

        34

    )



    # =====================
    # РЕДКОСТЬ
    # =====================

    rarity_text = RARITY_NAMES.get(

        rarity,

        rarity

    )


    draw_text(

        draw,

        CARD_LAYOUT["rarity"],

        rarity_text,

        34

    )



    # =====================
    # СОХРАНЕНИЕ
    # =====================

    filename = (

        f"{champion}_{skin}_{card_number}.png"

    ).replace(

        " ",

        "_"

    )


    path = os.path.join(

        OUTPUT,

        filename

    )


    card.save(

        path,

        optimize=True,

        compress_level=9

    )


    return path
