# =====================================
# ПОИСК АРТА КАРТЫ
# =====================================

def get_art_path(card):


    region_en = card.get(

        "region_en"

    )


    champion_en = card.get(

        "champion_en"

    )


    card_id = card.get(

        "id"

    )


    if not region_en:

        raise ValueError(

            "В cards.json нет region_en"

        )


    if not champion_en:

        raise ValueError(

            "В cards.json нет champion_en"

        )


    if not card_id:

        raise ValueError(

            "В cards.json нет id"

        )



    base_path = os.path.join(

        "assets",

        "champions",

        region_en,

        champion_en

    )



    extensions = [

        ".png",

        ".jpg",

        ".jpeg",

        ".webp"

    ]



    for ext in extensions:


        path = os.path.join(

            base_path,

            card_id + ext

        )



        if os.path.exists(path):

            return path



    raise FileNotFoundError(

        f"❌ Арт не найден: {base_path}/{card_id}"

    )
