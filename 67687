        "color": "#E91E63"
    },

    "Престижный": {
        "chance": 1,
        "color": "#FFD700"
    },

    "Чемпионский": {
        "chance": 0.2,
        "color": "#FFFFFF"
    }

}



# =====================================
# Редкость скинов League
# =====================================

SKIN_RARITY = {

    "prestige": "Престижный",

    "ultimate": "Чемпионский",

    "legendary": "Легендарный",

    "mythic": "Мифический",

    "epic": "Эпический",

    "rare": "Редкий"

}



# =====================================
# Определение редкости скина
# =====================================

def get_skin_rarity(skin_name):


    name = skin_name.lower()



    for key, rarity in SKIN_RARITY.items():


        if key in name:

            return rarity



    return None





# =====================================
# Получить случайную редкость карты
# =====================================

def get_card_rarity():


    roll = random.uniform(

        0,

        100

    )


    total = 0



    for rarity, data in CARD_RARITY.items():


        total += data["chance"]



        if roll <= total:

            return rarity



    return "Обычный"





# =====================================
# Финальная редкость карты
# =====================================
# Если скин особый -
# он получает свою редкость
# иначе обычный рандом


def get_final_rarity(skin_name):


    skin_rarity = get_skin_rarity(

        skin_name

    )



    if skin_rarity:

        return skin_rarity



    return get_card_rarity()





# =====================================
# Старые функции Loot
# =====================================


LOOT_TABLE = {


    "normal_monster": {


        "gold": {

            "min": 10,

            "max": 50

        },


        "items": [

            "Stone Fragment",

            "Sharp Claw"

        ],


        "cards": {

            "chance": 5

        }


    },





    "elite_monster": {


        "gold": {

            "min": 100,

            "max": 500

        },


        "items": [

            "Rare Essence",

            "Noxian Armor"

        ],


        "cards": {

            "chance": 20

        }


    },





    "boss": {


        "gold": {

            "min": 1000,

            "max": 5000

        },


        "items": [

            "Mythic Chest",

            "Legendary Essence"

        ],


        "cards": {

            "chance": 50

        }


    }


}





# =====================================
# Награды монстров
# =====================================


def monster_drop(monster_type):


    loot = LOOT_TABLE.get(

        monster_type

    )



    if not loot:

        return None




    gold = random.randint(

        loot["gold"]["min"],

        loot["gold"]["max"]

    )



    card_drop = random.randint(

        1,

        100

    )



    return {


        "gold": gold,


        "card_drop":

            card_drop <= loot["cards"]["chance"],



        "items":

            random.choice(

                loot["items"]

            )

    }
