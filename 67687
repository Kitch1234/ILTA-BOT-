# =========================
# ЧИТАЕМ CHAMPIONS.JSON
# =========================

with open(
    CHAMPIONS_FILE,
    "r",
    encoding="utf-8"
) as f:

    champions = json.load(f)



# =========================
# ИМЯ ФАЙЛА
# =========================

def clean_name(name):

    bad = [
        ":",
        "'",
        "/"
    ]

    for x in bad:
        name = name.replace(
            x,
            ""
        )


    return name.replace(
        " ",
        "_"
    )



# =========================
# СОХРАНЕНИЕ
# =========================

def save_image(
    url,
    path
):

    try:

        r = requests.get(
            url,
            timeout=20
        )


        if r.status_code != 200:
            return False


        img = Image.open(
            BytesIO(r.content)
        )


        img.save(
            path,
            "WEBP"
        )


        return True


    except Exception:

        return False



# =========================
# ЗАГРУЗКА
# =========================

for region, champs in REGION_CHAMPIONS.items():


    for champion in champs:


        if champion not in champions:
            continue



        print(
            "\n🌍",
            region,
            champion
        )


        folder = os.path.join(

            OUTPUT,

            region,

            champion

        )


        os.makedirs(
            folder,
            exist_ok=True
        )



        skins = champions[champion]["skins"]



        for skin in skins:


            skin_id = skin["id"]

            skin_name = skin["name"]



            if skin_name == "default":

                filename = "Base.webp"

            else:

                filename = (
                    clean_name(
                        skin_name
                    )
                    +
                    ".webp"
                )



            save_path = os.path.join(

                folder,

                filename

            )



            if os.path.exists(save_path):

                print(
                    "✔",
                    filename
                )

                continue



            # centered skin background
            url = (
                CDN
                +
                "plugins/rcp-be-lol-game-data/global/default/"
                "assets/characters/"
                + champion.lower()
                +
                "/skins/"
                + str(skin_id)
                +
                "/"
                + champion.lower()
                +
                "_splash_centered_"
                + str(skin_id)
                +
                ".jpg"
            )



            print(
                "⬇",
                skin_name
            )


            if save_image(
                url,
                save_path
            ):

                print(
                    "   OK"
                )

            else:

                print(
                    "   ❌ нет файла"
                )



print(
    "\n✅ Загрузка завершена"
)
