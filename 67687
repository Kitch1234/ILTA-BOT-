import discord
from discord.ext import commands
from discord import app_commands

import random
import os

from data.champion_loader import load_champions
from data.loot import get_card_rarity
from generators.card_generator import create_card



PACK_SIZE = 3



class PackView(discord.ui.View):

    def __init__(self, cards):

        super().__init__(
            timeout=300
        )

        self.cards = cards
        self.index = 0



    def create_embed(self):

        card = self.cards[self.index]


        embed = discord.Embed(

            title=f"🎴 {card['rarity']} | {card['champion']}",

            description=(

                f"✨ **{card['skin']}**\n"
                f"🆔 {card['code']}\n\n"

                f"⚔ Атака: {card['attack']}\n"
                f"❤️ Здоровье: {card['health']}\n"
                f"🛡 Защита: {card['defense']}\n"
                f"🌍 Регион: {card['region']}\n\n"

                f"Карта {self.index + 1}/{len(self.cards)}"

            ),

            color=0xFFD700

        )


        embed.set_image(

            url=(

                "attachment://"

                +

                os.path.basename(
                    card["file"]
                )

            )

        )


        return embed





    async def update(

        self,
        interaction

    ):

        await interaction.response.defer()


        await interaction.edit_original_response(

            embed=self.create_embed(),

            attachments=[

                discord.File(

                    self.cards[self.index]["file"]

                )

            ],

            view=self

        )





    @discord.ui.button(
        emoji="⬅️",
        style=discord.ButtonStyle.secondary
    )
    async def left(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):


        self.index -= 1


        if self.index < 0:

            self.index = len(self.cards)-1


        await self.update(
            interaction
        )





    @discord.ui.button(
        emoji="➡️",
        style=discord.ButtonStyle.primary
    )
    async def right(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):


        self.index += 1


        if self.index >= len(self.cards):

            self.index = 0


        await self.update(
            interaction
        )







class Pack(commands.Cog):


    def __init__(self, bot):

        self.bot = bot

        self.champions = load_champions()





    @app_commands.command(

        name="open_pack",

        description="Открыть ILTA Pack"

    )
    async def open_pack(

        self,

        interaction: discord.Interaction

    ):


        await interaction.response.defer()



        cards = []



        for i in range(PACK_SIZE):


            champion_name = random.choice(

                list(
                    self.champions.keys()
                )

            )


            champion = self.champions[champion_name]



            skin = random.choice(

                champion["skins"]

            )



            rarity = get_card_rarity()



            attack = random.randint(
                20,
                100
            )


            health = random.randint(
                50,
                150
            )


            defense = random.randint(
                10,
                80
            )


            code = (

                f"{random.randint(1,9999):04}"

            )



            card_file = create_card(

                champion=champion_name,

                skin=skin["name"],

                rarity=rarity,

                region=champion["region"],

                attack=attack,

                health=health,

                defense=defense,

                image_path=skin["file"],

                card_number=code

            )



            cards.append({

                "champion": champion_name,

                "skin": skin["name"],

                "rarity": rarity,

                "attack": attack,

                "health": health,

                "defense": defense,

                "region": champion["region"],

                "code": code,

                "file": card_file

            })





        view = PackView(
            cards
        )


        first_file = discord.File(

            cards[0]["file"]

        )



        await interaction.followup.send(

            embed=view.create_embed(),

            file=first_file,

            view=view

        )





async def setup(bot):

    await bot.add_cog(

        Pack(bot)

    )
