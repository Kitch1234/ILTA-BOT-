# =====================================
# EMBED КАРТЫ
# =====================================

def create_embed(card, index):

    embed = discord.Embed(
        color=0xD4AF37
    )

    embed.add_field(
        name="🛡 Чемпион",
        value=card["champion"],
        inline=True
    )

    if card["skin"]:

        embed.add_field(
            name="✨ Образ",
            value=card["skin"],
            inline=True
        )

    embed.add_field(
        name="⚔ Атака",
        value=str(card["attack"]),
        inline=True
    )

    embed.add_field(
        name="❤️ Здоровье",
        value=str(card["health"]),
        inline=True
    )

    embed.add_field(
        name="🛡 Защита",
        value=str(card["defense"]),
        inline=True
    )

ability = card.get("ability")

if ability:

    name = ability.get("name", "Без названия")
    description = ability.get("description", "Нет описания")

    embed.add_field(
        name=f"✨ {name}",
        value=description,
        inline=False
    )

    embed.set_footer(
        text=f"🎴 Карта {index + 1}/3"
    )

    return embed


# =====================================
# VIEW ПАКА
# =====================================

class PackView(discord.ui.View):

    def __init__(self, cards):

        super().__init__(
            timeout=180
        )

        self.cards = cards
        self.index = 0


    async def update_card(
        self,
        interaction: discord.Interaction
    ):

        await interaction.response.defer()

        card = self.cards[self.index]

        embed = create_embed(
            card,
            self.index
        )

        file_name = os.path.basename(
            card["file"]
        )

        file = discord.File(
            card["file"],
            filename=file_name
        )

        embed.set_image(
            url="attachment://" + file_name
        )

        await interaction.edit_original_response(
            embed=embed,
            attachments=[file],
            view=self
        )
    # =====================================
    # КНОПКА НАЗАД
    # =====================================

    @discord.ui.button(
        emoji="⬅️",
        style=discord.ButtonStyle.secondary
    )
    async def left(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):

        self.index -= 1

        if self.index < 0:
            self.index = len(self.cards) - 1

        await self.update_card(
            interaction
        )

    # =====================================
    # КНОПКА ВПЕРЁД
    # =====================================

    @discord.ui.button(
        emoji="➡️",
        style=discord.ButtonStyle.secondary
    )
    async def right(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):

        self.index += 1

        if self.index >= len(self.cards):
            self.index = 0

        await self.update_card(
            interaction
        )


# =====================================
# PACK
# =====================================

class Pack(commands.Cog):

    def __init__(self, bot):

        self.bot = bot

    # =====================================
    # OPEN PACK
    # =====================================

    @app_commands.command(
        name="open_pack",
        description="Открыть ILTA Pack"
    )
    async def open_pack(
        self,
        interaction: discord.Interaction
    ):

        await interaction.response.defer(
            thinking=True
        )

        cards = []
        # =====================================
        # СОЗДАНИЕ 3 КАРТ
        # =====================================

        for _ in range(3):

            # -----------------------------
            # Случайная карта из cards.json
            # -----------------------------

            card_data = get_random_card()

            champion_name = card_data["champion"]

            skin_name = card_data["skin"]

            rarity = card_data["rarity"]

            region = card_data["region"]

            image_path = get_art_path(card_data)

            # -----------------------------
            # Способность
            # -----------------------------

            ability_data = get_ability(

                card_data["id"],


            )

            ability = ability_data

            # -----------------------------
            # Статы
            # -----------------------------

            attack = random.randint(
                20,
                100
            )

            health = random.randint(
                50,
                150
            )

            defense = random.randint(
                10,
                80
            )

            code = f"{random.randint(1,9999):04}"

            # -----------------------------
            # Генерация изображения
            # -----------------------------

            try:

                card_file = await asyncio.wait_for(

                    asyncio.to_thread(

                        create_card,

                        champion_name,

                        skin_name,

                        rarity,

                        region,

                        attack,

                        health,

                        defense,

                        card_data["id"],

                        image_path,

                        code

                    ),

                    timeout=15

                )

            except asyncio.TimeoutError:

                await interaction.edit_original_response(

                    content="❌ Генерация карты заняла слишком много времени."

                )

                return

            except Exception as e:

                await interaction.edit_original_response(

                    content=f"❌ Ошибка генерации карты:\n```{e}```"

                )

                return
            # -----------------------------
            # Сохранение в PostgreSQL
            # -----------------------------

            try:

                await add_card(

                    interaction.user.id,

                    code,

                    champion_name,

                    skin_name,

                    region,

                    rarity,

                    attack,

                    defense,

                    health

                )

            except Exception as e:

                await interaction.edit_original_response(

                    content=f"❌ Ошибка PostgreSQL:\n```{e}```"

                )

                return

            # -----------------------------
            # Добавляем карту в список
            # -----------------------------

            cards.append({

                "champion": champion_name,

                "skin": skin_name,

                "rarity": rarity,

                "region": region,

                "attack": attack,

                "health": health,

                "defense": defense,

                "ability": ability,

                "code": code,

                "file": card_file

            })

        # =====================================
        # Показ первой карты
        # =====================================

        first = cards[0]

        embed = create_embed(

            first,

            0

        )

        file_name = os.path.basename(

            first["file"]

        )

        file = discord.File(

            first["file"],

            filename=file_name

        )

        embed.set_image(

            url="attachment://" + file_name

        )

        view = PackView(

            cards

        )

        await interaction.edit_original_response(

            content=None,

            embed=embed,

            attachments=[file],

            view=view

        )


# =====================================
# SETUP
# =====================================

async def setup(bot):

    await bot.add_cog(

        Pack(bot)

    )
