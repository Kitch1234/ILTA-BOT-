def get_frame(rarity):

    frame_name = FRAME_PATHS.get(rarity, "common.png")

    path = os.path.join(ASSETS, "frames", frame_name)

    if path not in FRAME_CACHE:

        if not os.path.exists(path):
            return None

        frame = Image.open(path).convert("RGBA")
        frame = frame.resize((CARD_WIDTH, CARD_HEIGHT), Image.LANCZOS)

        FRAME_CACHE[path] = frame

    return FRAME_CACHE[path]



