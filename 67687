from PIL import Image, ImageDraw, ImageFont
import os


# =========================
# НАСТРОЙКИ
# =========================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"


FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)

FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)


BACKGROUND = os.path.join(
    ASSETS,
    "backgrounds",
    "Set2_Title_Background_BG_TX.png"
)


FRAME_PATHS = {

    "Common": "common.png",
    "Rare": "rare.png",
    "Epic": "epic.png",
    "Legendary": "legendary.png",
    "Mythic": "mythic.png"

}


ICONS = {

    "attack": os.path.join(
        ASSETS,
        "icons",
        "attack.png"
    ),

    "health": os.path.join(
        ASSETS,
        "icons",
        "health.png"
    ),

    "defense": os.path.join(
        ASSETS,
        "icons",
        "defense.png"
    )

}


REGION_PATH = os.path.join(
    ASSETS,
    "regions"
)


OUTPUT = "generated_cards"


# =========================
# КООРДИНАТЫ
# =========================

CARD_LAYOUT = {


    "number": (900, 90),

    "champion": (530, 1010),

    "skin": (530, 1080),

    "attack": (250, 1210),

    "health": (530, 1210),

    "defense": (810, 1210),

    "region_text": (250, 1380),

    "rarity": (820, 1380)

}


# =========================
# ШРИФТЫ
# =========================

def font(path, size):

    return ImageFont.truetype(
        path,
        size
    )



# =========================
# ТЕКСТ С ТЕНЬЮ
# =========================

def draw_text(
    draw,
    pos,
    text,
    size,
    bold=True
):

    f = font(
        FONT_BOLD if bold else FONT_REGULAR,
        size
    )


    x, y = pos


    draw.text(
        (x + 3, y + 3),
        text,
        font=f,
        fill=(0,0,0)
    )


    draw.text(
        (x,y),
        text,
        font=f,
        fill=(255,255,255)
    )



# =========================
# ОБРЕЗКА АРТА
# =========================

def fit_image(
    image,
    size
):

    image.thumbnail(
        size,
        Image.LANCZOS
    )


    canvas = Image.new(
        "RGBA",
        size,
        (0,0,0,0)
    )


    x = (
        size[0]
        -
        image.width
    ) // 2


    y = (
        size[1]
        -
        image.height
    ) // 2


    canvas.paste(
        image,
        (x,y)
    )


    return canvas



# =========================
# ГЕНЕРАЦИЯ
# =========================

def create_card(
    champion,
    skin,
    rarity,
    region,
    attack,
    health,
    defense,
    image_path,
    card_number
):


    os.makedirs(
        OUTPUT,
        exist_ok=True
    )


    # фон

    card = Image.open(
        BACKGROUND
    ).convert(
        "RGBA"
    )


    card = card.resize(
        (
            CARD_WIDTH,
            CARD_HEIGHT
        )
    )



    # арт

    art = Image.open(
        image_path
    ).convert(
        "RGBA"
    )


    art = fit_image(
        art,
        (
            870,
            700
        )
    )


    card.alpha_composite(
        art,
        (
            95,
            170
        )
    )



    # рамка

    frame_file = FRAME_PATHS.get(
        rarity,
        "common.png"
    )


    frame = Image.open(
        os.path.join(
            ASSETS,
            "frames",
            frame_file
        )
    ).convert(
        "RGBA"
    )


    frame = frame.resize(
        (
            CARD_WIDTH,
            CARD_HEIGHT
        )
    )


    card.alpha_composite(
        frame
    )



    draw = ImageDraw.Draw(
        card
    )



    # тексты

    draw_text(
        draw,
        CARD_LAYOUT["number"],
        f"#{card_number}",
        36
    )


    draw_text(
        draw,
        CARD_LAYOUT["champion"],
        champion,
        54
    )


    draw_text(
        draw,
        CARD_LAYOUT["skin"],
        skin,
        38,
        False
    )



    # статы

    draw_text(
        draw,
        CARD_LAYOUT["attack"],
        str(attack),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["health"],
        str(health),
        50
    )


    draw_text(
        draw,
        CARD_LAYOUT["defense"],
        str(defense),
        50
    )



    # регион

    draw_text(
        draw,
        CARD_LAYOUT["region_text"],
        region,
        34
    )


    draw_text(
        draw,
        CARD_LAYOUT["rarity"],
        rarity,
        34
    )



    # сохраняем

    filename = (
        f"{champion}_{skin}_{card_number}.png"
        .replace(
            " ",
            "_"
        )
    )


    path = os.path.join(
        OUTPUT,
        filename
    )


    card.save(
        path
    )


    return path
