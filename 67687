# =====================================
# EMBED КАРТЫ
# =====================================

def create_embed(card, index):

    embed = discord.Embed(
        color=0xD4AF37
    )

    embed.add_field(
        name="🛡 Чемпион",
        value=card["champion"],
        inline=True
    )

    if card["skin"]:

        embed.add_field(
            name="✨ Образ",
            value=card["skin"],
            inline=True
        )

    embed.add_field(
        name="⚔ Атака",
        value=str(card["attack"]),
        inline=True
    )

    embed.add_field(
        name="❤️ Здоровье",
        value=str(card["health"]),
        inline=True
    )

    embed.add_field(
        name="🛡 Защита",
        value=str(card["defense"]),
        inline=True
    )

    if card["ability"]:

        embed.add_field(
            name="✨ Способность",
            value=card["ability"],
            inline=False
        )

    embed.set_footer(
        text=f"🎴 Карта {index + 1}/3"
    )

    return embed


# =====================================
# VIEW ПАКА
# =====================================

class PackView(discord.ui.View):

    def __init__(self, cards):

        super().__init__(
            timeout=180
        )

        self.cards = cards
        self.index = 0


    async def update_card(
        self,
        interaction: discord.Interaction
    ):

        await interaction.response.defer()

        card = self.cards[self.index]

        embed = create_embed(
            card,
            self.index
        )

        file_name = os.path.basename(
            card["file"]
        )

        file = discord.File(
            card["file"],
            filename=file_name
        )

        embed.set_image(
            url="attachment://" + file_name
        )

        await interaction.edit_original_response(
            embed=embed,
            attachments=[file],
            view=self
        )
