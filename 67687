def create_card(
    champion,
    skin,
    rarity,
    region,
    attack,
    health,
    defense,
    ability,
    image_path,
    card_number
):
    os.makedirs(
        OUTPUT,
        exist_ok=True
    )

    # =============================
    # ПОЛОТНО
    # =============================
    card = Image.new(
        "RGBA",
        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),
        (
            0,
            0,
            0,
            0
        )
    )

    # =============================
    # АРТ
    # =============================
    art = get_art(image_path)

    card.alpha_composite(
        art,
        (
            ART_X,
            ART_Y
        )
    )

    # =============================
    # РАМКА
    # =============================
    frame = get_frame(rarity)

    if frame:
        card.alpha_composite(frame)

        # =============================
    # ИКОНКА РЕГИОНА
    # =============================
    region_icon = get_region_icon(region)

    draw = ImageDraw.Draw(card)

    settings = RARITY_SETTINGS.get(
        rarity,
        RARITY_SETTINGS["Обычный"]
    )

    layout = settings["layout"]
    text_color = settings["text_color"]
    shadow_color = settings["shadow_color"]

    if region_icon:
        card.alpha_composite(
            region_icon,
            layout["region_icon"]
        )

    # =============================
    # НОМЕР
    # =============================
    draw_center_text(
        draw,
        layout["number"],
        f"#{card_number}",
        32,
        bold=True,
        max_width=160,
        fill=text_color,
        shadow_fill=shadow_color
    )

    # =============================
    # ЧЕМПИОН
    # =============================
    draw_center_text(
        draw,
        layout["champion"],
        champion,
        60,
        bold=True,
        max_width=860,
        spacing=2,
        fill=text_color,
        shadow_fill=shadow_color
    )

    # =============================
    # СКИН
    # =============================
    if skin and skin.lower() != "default":
        draw_center_text(
            draw,
            layout["skin"],
            skin,
            36,
            bold=False,
            max_width=860,
            fill=text_color,
            shadow_fill=shadow_color
        )

    # =============================
    # СТАТЫ
    # =============================
    draw_stat(
        draw,
        layout["attack"],
        attack
        fill=text_color,
        shadow_fill=shadow_color
    )

    draw_stat(
        draw,
        layout["health"],
        health
        fill=text_color,
        shadow_fill=shadow_color
    )

    draw_stat(
        draw,
        layout["defense"],
        defense
        fill=text_color,
        shadow_fill=shadow_color
    )
    # =============================
    # СПОСОБНОСТЬ
    # =============================
    draw_ability_block(
        draw,
        ability,
        rarity
    )

    # =============================
    # СОХРАНЕНИЕ
    # =============================
    filename = f"{champion}_{card_number}.png"
    filename = filename.replace(" ", "_")

    path = os.path.join(
        OUTPUT,
        filename
    )

    card.save(
        path,
        "PNG",
        optimize=True,
        compress_level=9
    )

    return path
