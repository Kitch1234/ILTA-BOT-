import discord
from discord.ext import commands
from discord import app_commands

import random
import os

from database.cards import add_card

from data.champion_loader import load_champions
from data.loot import get_card_rarity

from generators.card_generator import create_card



def create_embed(card, index):

    embed = discord.Embed(
        title=f"🎴 {card['rarity']} | {card['champion']}",
        description=(
            f"✨ **{card['skin']}**\n"
            f"🆔 {card['code']}"
        ),
        color=0xFFD700
    )


    embed.add_field(
        name="⚔ Атака",
        value=str(card["attack"]),
        inline=True
    )

    embed.add_field(
        name="❤️ Здоровье",
        value=str(card["health"]),
        inline=True
    )

    embed.add_field(
        name="🛡 Защита",
        value=str(card["defense"]),
        inline=True
    )

    embed.add_field(
        name="🌍 Регион",
        value=card["region"],
        inline=True
    )


    embed.set_footer(
        text=f"Карта {index + 1}/3"
    )


    return embed





class PackView(discord.ui.View):


    def __init__(self, cards):

        super().__init__(
            timeout=180
        )

        self.cards = cards
        self.index = 0




    async def show_card(self, interaction):

        card = self.cards[self.index]


        embed = create_embed(
            card,
            self.index
        )


        await interaction.response.defer()


        file = discord.File(
            card["file"]
        )


        embed.set_image(
            url=
            "attachment://"
            +
            os.path.basename(
                card["file"]
            )
        )


        await interaction.edit_original_response(

            embed=embed,

            attachments=[file],

            view=self

        )





    @discord.ui.button(
        emoji="⬅️",
        style=discord.ButtonStyle.secondary
    )
    async def left(
        self,
        interaction,
        button
    ):


        self.index -= 1


        if self.index < 0:

            self.index = 2



        await self.show_card(
            interaction
        )





    @discord.ui.button(
        emoji="➡️",
        style=discord.ButtonStyle.secondary
    )
    async def right(
        self,
        interaction,
        button
    ):


        self.index += 1


        if self.index > 2:

            self.index = 0



        await self.show_card(
            interaction
        )







class Pack(commands.Cog):


    def __init__(self, bot):

        self.bot = bot

        self.champions = load_champions()





    @app_commands.command(

        name="open_pack",

        description="Открыть ILTA Pack"

    )
    async def open_pack(

        self,

        interaction: discord.Interaction

    ):


        await interaction.response.defer()



        cards = []



        for i in range(3):


            champion_id = random.choice(
                list(
                    self.champions.keys()
                )
            )


            champion = self.champions[champion_id]


            skin = random.choice(
                champion["skins"]
            )



            rarity = get_card_rarity()



            attack = random.randint(
                20,
                100
            )

            health = random.randint(
                50,
                150
            )

            defense = random.randint(
                10,
                80
            )



            code = (
                f"{random.randint(1,9999):04}"
            )



            await add_card(

                interaction.user.id,

                code,

                champion_id,

                skin["name"],

                champion["region"],

                rarity,

                attack,

                defense,

                health

            )



            card_file = create_card(

                champion=champion_id,

                skin=skin["name"],

                rarity=rarity,

                region=champion["region"],

                attack=attack,

                health=health,

                defense=defense,

                image_path=skin["file"],

                card_number=code

            )



            cards.append({

                "champion": champion_id,

                "skin": skin["name"],

                "rarity": rarity,

                "region": champion["region"],

                "attack": attack,

                "health": health,

                "defense": defense,

                "code": code,

                "file": card_file

            })





        first = cards[0]


        embed = create_embed(
            first,
            0
        )


        file = discord.File(
            first["file"]
        )


        embed.set_image(
            url=
            "attachment://"
            +
            os.path.basename(
                first["file"]
            )
        )



        await interaction.followup.send(

            embed=embed,

            file=file,

            view=PackView(cards)

        )





async def setup(bot):

    await bot.add_cog(
        Pack(bot)
    )
