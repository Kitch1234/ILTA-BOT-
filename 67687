import discord
from discord.ext import commands
from discord import app_commands

import random
import os

from database.cards import add_card

from data.champion_loader import load_champions
from data.loot import get_card_rarity

from data.translations import (
    get_skin_name,
    get_champion_name
)

from generators.card_generator import create_card



class PackView(discord.ui.View):


    def __init__(self, cards):

        super().__init__(
            timeout=180
        )

        self.cards = cards
        self.index = 0



    async def update_message(
        self,
        interaction
    ):

        card = self.cards[self.index]


        embed = create_embed(
            card,
            self.index + 1,
            len(self.cards)
        )


        file = discord.File(
            card["file"]
        )


        embed.set_image(

            url=
            "attachment://"
            +
            os.path.basename(
                card["file"]
            )

        )


        await interaction.response.edit_message(

            embed=embed,

            attachments=[file],

            view=self

        )




    @discord.ui.button(
        emoji="⬅️",
        style=discord.ButtonStyle.secondary
    )
    async def previous(
        self,
        interaction,
        button
    ):

        self.index -= 1


        if self.index < 0:

            self.index = len(self.cards)-1


        await self.update_message(
            interaction
        )





    @discord.ui.button(
        emoji="➡️",
        style=discord.ButtonStyle.secondary
    )
    async def next(
        self,
        interaction,
        button
    ):

        self.index += 1


        if self.index >= len(self.cards):

            self.index = 0


        await self.update_message(
            interaction
        )






def create_embed(
    card,
    number,
    total
):


    embed = discord.Embed(

        title=f"🎴 {card['rarity']} | {card['champion']}",

        description=(

            f"✨ **{card['skin']}**\n"

            f"🆔 {card['code']}"

        ),

        color=0xFFD700

    )


    embed.add_field(

        name="⚔ Атака",

        value=str(card["attack"])

    )


    embed.add_field(

        name="❤️ Здоровье",

        value=str(card["health"])

    )


    embed.add_field(

        name="🛡 Защита",

        value=str(card["defense"])

    )


    embed.add_field(

        name="🌍 Регион",

        value=card["region"]

    )


    embed.set_footer(

        text=f"Карта {number}/{total}"

    )


    return embed






class Pack(commands.Cog):


    def __init__(self, bot):

        self.bot = bot

        self.champions = load_champions()



    @app_commands.command(

        name="open_pack",

        description="Открыть ILTA Pack (3 карты)"

    )
    async def open_pack(

        self,

        interaction: discord.Interaction

    ):


        await interaction.response.defer()



        cards = []



        for i in range(3):


            champion_id = random.choice(

                list(
                    self.champions.keys()
                )

            )


            champion = self.champions[champion_id]



            skin = random.choice(

                champion["skins"]

            )


            rarity = get_card_rarity()



            attack = random.randint(
                20,
                100
            )


            health = random.randint(
                50,
                150
            )


            defense = random.randint(
                10,
                80
            )



            code = (

                f"{random.randint(1,9999):04}"

            )



            await add_card(

                interaction.user.id,

                code,

                champion_id,

                skin["name"],

                champion["region"],

                rarity,

                attack,

                defense,

                health

            )



            card_file = create_card(

                champion=champion_id,

                skin=skin["name"],

                rarity=rarity,

                region=champion["region"],

                attack=attack,

                health=health,

                defense=defense,

                image_path=skin["file"],

                card_number=code

            )



            cards.append({

                "champion": champion_id,

                "skin": skin["name"],

                "rarity": rarity,

                "region": champion["region"],

                "attack": attack,

                "health": health,

                "defense": defense,

                "code": code,

                "file": card_file

            })




        view = PackView(
            cards
        )



        first = cards[0]


        embed = create_embed(

            first,

            1,

            3

        )


        file = discord.File(

            first["file"]

        )


        embed.set_image(

            url=
            "attachment://"
            +
            os.path.basename(
                first["file"]
            )

        )



        await interaction.followup.send(

            embed=embed,

            file=file,

            view=view

        )






async def setup(bot):

    await bot.add_cog(
        Pack(bot)
    )
