def prepare_art(image):


    # дополнительное приближение арта

    zoom = 1.25


    target_width = int(
        ART_WIDTH * zoom
    )

    target_height = int(
        ART_HEIGHT * zoom
    )



    scale = max(

        target_width / image.width,

        target_height / image.height

    )



    image = image.resize(

        (

            int(image.width * scale),

            int(image.height * scale)

        ),

        Image.LANCZOS

    )



    left = (

        image.width - ART_WIDTH

    ) // 2



    top = (

        image.height - ART_HEIGHT

    ) // 2



    return image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )
