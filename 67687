from PIL import Image, ImageDraw, ImageFont, ImageFilter
import os



# =========================
# РАЗМЕР КАРТЫ
# =========================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"

OUTPUT = "generated_cards"



# =========================
# ШРИФТЫ
# =========================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =========================
# РАМКИ
# =========================

FRAME_PATHS = {

    "Обычный": "common.png",
    "Редкий": "rare.png",
    "Эпический": "epic.png",
    "Легендарный": "legendary.png",
    "Мифический": "mythic.png"

}



# =========================
# ТЕКСТ
# =========================

CARD_LAYOUT = {

    "number": (900,90),

    "champion": (530,1010),

    "skin": (530,1080),

    "attack": (250,1210),

    "health": (530,1210),

    "defense": (810,1210),

    "region": (250,1380),

    "rarity": (820,1380)

}




def get_font(path,size):

    return ImageFont.truetype(
        path,
        size
    )




def draw_text(
    draw,
    position,
    text,
    size,
    bold=True
):

    font = get_font(

        FONT_BOLD if bold else FONT_REGULAR,

        size

    )


    x,y = position


    draw.text(

        (
            x+3,
            y+3
        ),

        text,

        font=font,

        fill=(0,0,0,220)

    )


    draw.text(

        (
            x,
            y
        ),

        text,

        font=font,

        fill=(255,255,255)

    )





# =========================
# АРТ + ФОН
# =========================

def prepare_art(image):


    # ---------- ФОН ----------

    bg = image.copy()



    ratio = max(

        CARD_WIDTH / bg.width,

        CARD_HEIGHT / bg.height

    )


    bg = bg.resize(

        (

            int(bg.width*ratio),

            int(bg.height*ratio)

        ),

        Image.LANCZOS

    )


    left = (

        bg.width-CARD_WIDTH

    )//2


    top = (

        bg.height-CARD_HEIGHT

    )//2



    bg = bg.crop(

        (

            left,

            top,

            left+CARD_WIDTH,

            top+CARD_HEIGHT

        )

    )


    bg = bg.filter(

        ImageFilter.GaussianBlur(25)

    )



    # ---------- ОРИГИНАЛ ----------


    fg = image.copy()



    ratio = min(

        CARD_WIDTH / fg.width,

        CARD_HEIGHT / fg.height

    )


    fg = fg.resize(

        (

            int(fg.width*ratio),

            int(fg.height*ratio)

        ),

        Image.LANCZOS

    )



    result = Image.new(

        "RGBA",

        (

            CARD_WIDTH,

            CARD_HEIGHT

        )

    )


    result.alpha_composite(

        bg,

        (
            0,
            0
        )

    )


    x = (

        CARD_WIDTH-fg.width

    )//2


    y = (

        CARD_HEIGHT-fg.height

    )//2



    result.alpha_composite(

        fg,

        (
            x,
            y
        )

    )


    return result





# =========================
# СОЗДАНИЕ КАРТЫ
# =========================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    card = Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,0)

    )



    art = Image.open(

        image_path

    ).convert(

        "RGBA"

    )



    art = prepare_art(

        art

    )


    card.alpha_composite(

        art

    )



    # =====================
    # РАМКА
    # =====================


    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )



    if os.path.exists(frame_path):


        frame = Image.open(

            frame_path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            ),

            Image.LANCZOS

        )


        card.alpha_composite(

            frame

        )



    draw = ImageDraw.Draw(

        card

    )



    # =====================
    # ТЕКСТ
    # =====================


    draw_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        36

    )


    draw_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        54

    )


    draw_text(

        draw,

        CARD_LAYOUT["skin"],

        skin,

        38,

        False

    )



    draw_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )



    draw_text(

        draw,

        CARD_LAYOUT["region"],

        region,

        34

    )


    draw_text(

        draw,

        CARD_LAYOUT["rarity"],

        rarity,

        34

    )



    filename = (

        f"{champion}_{skin}_{card_number}.png"

    ).replace(

        " ",

        "_"

    )



    path = os.path.join(

        OUTPUT,

        filename

    )


    card.save(

        path

    )


    return path
