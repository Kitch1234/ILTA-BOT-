import discord
from discord.ext import commands
from discord import app_commands

import random
import os

from database.cards import add_card
from data.champion_loader import load_champions
from data.loot import get_card_rarity
from generators.card_generator import create_card


# ==========================================
# EMBED
# ==========================================

def create_embed(card, index):

    embed = discord.Embed(
        color=0x000000
    )

    embed.set_footer(
        text=f"{index + 1}/3"
    )

    return embed


# ==========================================
# VIEW
# ==========================================

class PackView(discord.ui.View):

    def __init__(self, cards):

        super().__init__(timeout=180)

        self.cards = cards
        self.index = 0

    async def update(self, interaction):

        card = self.cards[self.index]

        embed = create_embed(
            card,
            self.index
        )

        file = discord.File(
            card["file"],
            filename=os.path.basename(card["file"])
        )

        embed.set_image(
            url="attachment://" +
            os.path.basename(card["file"])
        )

        await interaction.response.edit_message(
            embed=embed,
            attachments=[file],
            view=self
        )

    @discord.ui.button(
        emoji="⬅️",
        style=discord.ButtonStyle.secondary
    )
    async def left(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):

        self.index -= 1

        if self.index < 0:
            self.index = len(self.cards) - 1

        await self.update(interaction)

    @discord.ui.button(
        emoji="➡️",
        style=discord.ButtonStyle.secondary
    )
    async def right(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button
    ):

        self.index += 1

        if self.index >= len(self.cards):
            self.index = 0

        await self.update(interaction)


# ==========================================
# COG
# ==========================================

class Pack(commands.Cog):

    def __init__(self, bot):

        self.bot = bot
        self.champions = load_champions()

    @app_commands.command(
        name="open_pack",
        description="Открыть ILTA Pack"
    )
    async def open_pack(
        self,
        interaction: discord.Interaction
    ):

        await interaction.response.defer(thinking=True)

        cards = []

        for _ in range(3):

            champion_id = random.choice(
                list(self.champions.keys())
            )

            champion = self.champions[champion_id]

            skin = random.choice(
                champion["skins"]
            )

            rarity = get_card_rarity()

            attack = random.randint(20, 100)
            health = random.randint(50, 150)
            defense = random.randint(10, 80)

            code = f"{random.randint(1,9999):04}"

            await add_card(
                interaction.user.id,
                code,
                champion_id,
                skin["name"],
                champion["region"],
                rarity,
                attack,
                defense,
                health
            )

            card_file = create_card(
                champion=champion_id,
                skin=skin["name"],
                rarity=rarity,
                region=champion["region"],
                attack=attack,
                health=health,
                defense=defense,
                image_path=skin["file"],
                card_number=code
            )

            cards.append({
                "champion": champion_id,
                "skin": skin["name"],
                "rarity": rarity,
                "region": champion["region"],
                "attack": attack,
                "health": health,
                "defense": defense,
                "code": code,
                "file": card_file
            })
        # ==================================
        # ПОКАЗ ПЕРВОЙ КАРТЫ
        # ==================================

        first = cards[0]


        embed = create_embed(
            first,
            0
        )


        file = discord.File(

            first["file"],

            filename=os.path.basename(
                first["file"]
            )

        )


        embed.set_image(

            url="attachment://" +

            os.path.basename(
                first["file"]
            )

        )


        view = PackView(

            cards

        )


        await interaction.edit_original_response(

            content=None,

            embed=embed,

            attachments=[file],

            view=view

        )



# ==========================================
# SETUP
# ==========================================

async def setup(bot):

    await bot.add_cog(

        Pack(bot)

    )
