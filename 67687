from PIL import Image, ImageDraw, ImageFont
import os


# =========================
# РАЗМЕР КАРТЫ
# =========================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"


# =========================
# ШРИФТЫ
# =========================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)

FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =========================
# РАМКИ
# =========================

FRAME_PATHS = {

    "Common": "common.png",
    "Rare": "rare.png",
    "Epic": "epic.png",
    "Legendary": "legendary.png",
    "Mythic": "mythic.png"

}



# =========================
# КООРДИНАТЫ
# =========================

CARD_LAYOUT = {

    "number": (900, 90),

    "champion": (530, 1010),

    "skin": (530, 1080),

    "attack": (250, 1210),

    "health": (530, 1210),

    "defense": (810, 1210),

    "region_text": (250, 1380),

    "rarity": (820, 1380)

}



OUTPUT = "generated_cards"



# =========================
# ШРИФТ
# =========================

def get_font(
    path,
    size
):

    return ImageFont.truetype(
        path,
        size
    )



# =========================
# ТЕКСТ С ТЕНЬЮ
# =========================

def draw_text(
    draw,
    position,
    text,
    size,
    bold=True
):

    font = get_font(
        FONT_BOLD if bold else FONT_REGULAR,
        size
    )


    x, y = position


    # тень

    draw.text(
        (
            x + 3,
            y + 3
        ),
        text,
        font=font,
        fill=(0,0,0,220)
    )


    # текст

    draw.text(
        (
            x,
            y
        ),
        text,
        font=font,
        fill=(255,255,255)
    )



# =========================
# ЗАПОЛНЕНИЕ КАРТИНКОЙ
# =========================

def fit_image(
    image,
    size
):

    ratio = max(
        size[0] / image.width,
        size[1] / image.height
    )


    new_size = (

        int(
            image.width * ratio
        ),

        int(
            image.height * ratio
        )

    )


    image = image.resize(
        new_size,
        Image.LANCZOS
    )


    left = (

        image.width
        -
        size[0]

    ) // 2


    top = (

        image.height
        -
        size[1]

    ) // 2



    image = image.crop(

        (
            left,
            top,
            left + size[0],
            top + size[1]
        )

    )


    return image



# =========================
# СОЗДАНИЕ КАРТЫ
# =========================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(
        OUTPUT,
        exist_ok=True
    )



    # =====================
    # ЧЕРНЫЙ ФОН ПОД АРТ
    # =====================

    card = Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,255)

    )



    # =====================
    # АРТ ЧЕМПИОНА
    # =====================

    art = Image.open(
        image_path
    ).convert(
        "RGBA"
    )


    art = fit_image(

        art,

        (
            CARD_WIDTH,
            CARD_HEIGHT
        )

    )


    card.alpha_composite(
        art,
        (
            0,
            0
        )
    )



    # =====================
    # РАМКА
    # =====================

    frame_name = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_name

    )


    if os.path.exists(frame_path):

        frame = Image.open(

            frame_path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            ),

            Image.LANCZOS

        )


        card.alpha_composite(
            frame
        )



    draw = ImageDraw.Draw(
        card
    )



    # =====================
    # ТЕКСТ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        36

    )



    draw_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        54

    )



    draw_text(

        draw,

        CARD_LAYOUT["skin"],

        skin,

        38,

        False

    )



    # =====================
    # СТАТЫ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )



    # =====================
    # НИЖНЯЯ ИНФОРМАЦИЯ
    # =====================

    draw_text(

        draw,

        CARD_LAYOUT["region_text"],

        region,

        34

    )


    draw_text(

        draw,

        CARD_LAYOUT["rarity"],

        rarity,

        34

    )



    # =====================
    # СОХРАНЕНИЕ
    # =====================

    filename = (

        f"{champion}_{skin}_{card_number}.png"

    ).replace(

        " ",

        "_"

    )


    path = os.path.join(

        OUTPUT,

        filename

    )


    card.save(

        path

    )


    return path
