import discord
from discord.ext import commands
from discord import app_commands

import random
import os
import asyncio


from database.cards import add_card
from data.champion_loader import load_champions
from generators.card_generator import create_card



# =====================================
# EMBED КАРТЫ
# =====================================

def create_embed(card, index):

    embed = discord.Embed(
        color=0xD4AF37
    )


    embed.add_field(
        name="🛡 Чемпион",
        value=card["champion"],
        inline=True
    )


    if card["skin"] and card["skin"].lower() != "default":

        embed.add_field(
            name="✨ Скин",
            value=card["skin"],
            inline=True
        )


    embed.add_field(
        name="⚔ Атака",
        value=str(card["attack"]),
        inline=True
    )


    embed.add_field(
        name="❤️ Здоровье",
        value=str(card["health"]),
        inline=True
    )


    embed.add_field(
        name="🛡 Защита",
        value=str(card["defense"]),
        inline=True
    )


    if card.get("ability"):

        embed.add_field(
            name="✨ Способность",
            value=card["ability"],
            inline=False
        )


    embed.set_footer(
        text=f"🎴 Карта {index + 1}/3"
    )


    return embed
# =====================================
# VIEW ПАКА
# =====================================

class PackView(discord.ui.View):


    def __init__(self, cards):

        super().__init__(
            timeout=180
        )


        self.cards = cards

        self.index = 0





    # =====================================
    # ОБНОВЛЕНИЕ КАРТЫ
    # =====================================

    async def update_card(

        self,

        interaction: discord.Interaction

    ):


        await interaction.response.defer()



        card = self.cards[self.index]



        embed = create_embed(

            card,

            self.index

        )



        file_name = os.path.basename(

            card["file"]

        )



        file = discord.File(

            card["file"],

            filename=file_name

        )



        embed.set_image(

            url="attachment://" + file_name

        )



        await interaction.edit_original_response(

            embed=embed,

            attachments=[file],

            view=self

        )





    # =====================================
    # КНОПКА НАЗАД
    # =====================================

    @discord.ui.button(

        emoji="⬅️",

        style=discord.ButtonStyle.secondary

    )
    async def left(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):


        self.index -= 1



        if self.index < 0:

            self.index = len(self.cards) - 1



        await self.update_card(

            interaction

        )





    # =====================================
    # КНОПКА ВПЕРЁД
    # =====================================

    @discord.ui.button(

        emoji="➡️",

        style=discord.ButtonStyle.secondary

    )
    async def right(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):


        self.index += 1



        if self.index >= len(self.cards):

            self.index = 0



        await self.update_card(

            interaction

        )
# =====================================
# PACK COG
# =====================================

class Pack(commands.Cog):


    def __init__(self, bot):

        self.bot = bot

        self.champions = load_champions()





    # =====================================
    # OPEN PACK
    # =====================================

    @app_commands.command(

        name="open_pack",

        description="Открыть ILTA Pack"

    )
    async def open_pack(

        self,

        interaction: discord.Interaction

    ):


        await interaction.response.defer(

            thinking=True

        )



        cards = []



        # создаём 3 карты

        for _ in range(3):


            # выбираем чемпиона

            champion_id = random.choice(

                list(self.champions.keys())

            )


            champion = self.champions[champion_id]


            # имя чемпиона из ключа

            champion_name = champion_id



            # выбираем скин

            skin = random.choice(

                champion["skins"]

            )



            rarity = skin.get(

                "tier",

                "Обычный"

            )



            attack = random.randint(

                20,

                100

            )


            health = random.randint(

                50,

                150

            )


            defense = random.randint(

                10,

                80

            )



            code = f"{random.randint(1,9999):04}"



            ability = ""





            # =================================
            # ГЕНЕРАЦИЯ КАРТЫ
            # =================================

            try:


                card_file = await asyncio.wait_for(

                    asyncio.to_thread(

                        create_card,

                        champion_name,

                        skin["name"],

                        rarity,

                        champion["region"],

                        attack,

                        health,

                        defense,

                        ability,

                        skin["file"],

                        code

                    ),

                    timeout=15

                )



            except asyncio.TimeoutError:


                await interaction.edit_original_response(

                    content="❌ Генерация карты слишком долго"

                )

                return



            except Exception as e:


                await interaction.edit_original_response(

                    content=f"❌ Ошибка генерации карты:\n```{e}```"

                )

                return
            # =================================
            # СОХРАНЕНИЕ В POSTGRESQL
            # =================================

            try:

                await add_card(

                    interaction.user.id,

                    code,

                    champion_name,

                    skin["name"],

                    champion["region"],

                    rarity,

                    attack,

                    defense,

                    health

                )


            except Exception as e:


                await interaction.edit_original_response(

                    content=f"❌ Ошибка PostgreSQL:\n```{e}```"

                )

                return





            # =================================
            # ДОБАВЛЕНИЕ КАРТЫ В ПАК
            # =================================

            cards.append({

                "champion": champion_name,

                "skin": skin["name"],

                "rarity": rarity,

                "region": champion["region"],

                "attack": attack,

                "health": health,

                "defense": defense,

                "ability": ability,

                "code": code,

                "file": card_file

            })





        # =====================================
        # ПОКАЗ ПЕРВОЙ КАРТЫ
        # =====================================

        first = cards[0]


        embed = create_embed(

            first,

            0

        )


        file_name = os.path.basename(

            first["file"]

        )


        file = discord.File(

            first["file"],

            filename=file_name

        )


        embed.set_image(

            url="attachment://" + file_name

        )


        view = PackView(

            cards

        )



        await interaction.edit_original_response(

            content=None,

            embed=embed,

            attachments=[file],

            view=view

        )





# =====================================
# SETUP
# =====================================

async def setup(bot):

    await bot.add_cog(

        Pack(bot)

    )
