def prepare_art(image):


    # увеличиваем картинку так,
    # чтобы она полностью закрыла область

    scale = max(

        ART_WIDTH / image.width,

        ART_HEIGHT / image.height

    )


    new_size = (

        int(image.width * scale),

        int(image.height * scale)

    )


    image = image.resize(

        new_size,

        Image.LANCZOS

    )


    # центрируем кадр

    left = (

        image.width - ART_WIDTH

    ) // 2


    top = (

        image.height - ART_HEIGHT

    ) // 2



    return image.crop(

        (

            left,

            top,

            left + ART_WIDTH,

            top + ART_HEIGHT

        )

    )
