import json
import os


# =====================================
# НАСТРОЙКИ
# =====================================

FILE = "cards.json"


REGION_MAP = {

    "Демасия": "Demacia",

    "Ноксус": "Noxus"

}





# =====================================
# ОБНОВЛЕНИЕ
# =====================================

def update_cards():


    if not os.path.exists(FILE):

        print(
            "❌ cards.json не найден"
        )

        return



    with open(

        FILE,

        "r",

        encoding="utf-8"

    ) as f:

        cards = json.load(f)



    count = 0



    for card_id, card in cards.items():


        region = card.get(
            "region"
        )


        if region in REGION_MAP:


            card["region_en"] = REGION_MAP[region]

            count += 1



    with open(

        FILE,

        "w",

        encoding="utf-8"

    ) as f:


        json.dump(

            cards,

            f,

            ensure_ascii=False,

            indent=4

        )



    print(
        f"✅ Обновлено карт: {count}"
    )





if __name__ == "__main__":

    update_cards()
