import os
import re


FOLDER = "assets/champions"


def clean_name(name):

    # расширение
    filename, ext = os.path.splitext(name)

    # заменяем пробелы
    filename = filename.replace(" ", "_")

    # убираем лишнее
    filename = filename.replace(":", "")
    filename = filename.replace("'", "")
    filename = filename.replace("-", "_")

    # двойные _
    filename = re.sub(
        "_+",
        "_",
        filename
    )

    return filename + ext.lower()



def rename_folder(path):

    for root, dirs, files in os.walk(path):

        for file in files:

            old = os.path.join(
                root,
                file
            )


            new_name = clean_name(
                file
            )


            new = os.path.join(
                root,
                new_name
            )


            if old != new:

                os.rename(
                    old,
                    new
                )

                print(
                    "✔",
                    file,
                    "→",
                    new_name
                )



rename_folder(
    FOLDER
)


print(
    "\n✅ Переименование завершено"
)
