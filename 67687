from PIL import Image, ImageDraw, ImageFont
import os


# =========================
# РАЗМЕР КАРТЫ
# =========================

CARD_WIDTH = 1060
CARD_HEIGHT = 1484


ASSETS = "assets"

OUTPUT = "generated_cards"



# =========================
# ОБЛАСТЬ АРТА
# =========================

ART_X = 95
ART_Y = 180

ART_WIDTH = 870
ART_HEIGHT = 720



# =========================
# ШРИФТЫ
# =========================

FONT_BOLD = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Bold.ttf"
)


FONT_REGULAR = os.path.join(
    ASSETS,
    "fonts",
    "Beaufort-Regular.ttf"
)



# =========================
# РАМКИ
# =========================

FRAME_PATHS = {

    "Common": "common.png",
    "Rare": "rare.png",
    "Epic": "epic.png",
    "Legendary": "legendary.png",
    "Mythic": "mythic.png"

}



# =========================
# ТЕКСТ
# =========================

CARD_LAYOUT = {

    "number": (900, 90),

    "champion": (530, 1010),

    "skin": (530, 1080),

    "attack": (250, 1210),

    "health": (530, 1210),

    "defense": (810, 1210),

    "region_text": (250, 1380),

    "rarity": (820, 1380)

}



# =========================
# ШРИФТ
# =========================

def get_font(path, size):

    return ImageFont.truetype(
        path,
        size
    )



# =========================
# ТЕКСТ С ТЕНЬЮ
# =========================

def draw_text(
    draw,
    position,
    text,
    size,
    bold=True
):

    font = get_font(
        FONT_BOLD if bold else FONT_REGULAR,
        size
    )


    x, y = position


    draw.text(
        (
            x + 3,
            y + 3
        ),
        text,
        font=font,
        fill=(0,0,0,220)
    )


    draw.text(
        (
            x,
            y
        ),
        text,
        font=font,
        fill=(255,255,255,255)
    )



# =========================
# ЦЕНТРИРОВАННЫЙ CROP
# =========================

def fit_image(
    image,
    size
):

    target_w, target_h = size


    ratio = max(

        target_w / image.width,

        target_h / image.height

    )


    new_size = (

        int(image.width * ratio),

        int(image.height * ratio)

    )


    image = image.resize(

        new_size,

        Image.LANCZOS

    )


    left = (

        image.width - target_w

    ) // 2



    top = (

        image.height - target_h

    ) // 2



    image = image.crop(

        (

            left,

            top,

            left + target_w,

            top + target_h

        )

    )


    return image



# =========================
# СОЗДАНИЕ КАРТЫ
# =========================

def create_card(

    champion,

    skin,

    rarity,

    region,

    attack,

    health,

    defense,

    image_path,

    card_number

):


    os.makedirs(

        OUTPUT,

        exist_ok=True

    )



    # =====================
    # ПРОЗРАЧНЫЙ ФОН
    # =====================

    card = Image.new(

        "RGBA",

        (
            CARD_WIDTH,
            CARD_HEIGHT
        ),

        (0,0,0,0)

    )



    # =====================
    # АРТ
    # =====================

    art = Image.open(

        image_path

    ).convert(

        "RGBA"

    )


    art = fit_image(

        art,

        (
            ART_WIDTH,
            ART_HEIGHT
        )

    )


    card.alpha_composite(

        art,

        (
            ART_X,
            ART_Y
        )

    )



    # =====================
    # РАМКА
    # =====================

    frame_file = FRAME_PATHS.get(

        rarity,

        "common.png"

    )


    frame_path = os.path.join(

        ASSETS,

        "frames",

        frame_file

    )



    if os.path.exists(frame_path):


        frame = Image.open(

            frame_path

        ).convert(

            "RGBA"

        )


        frame = frame.resize(

            (
                CARD_WIDTH,
                CARD_HEIGHT
            ),

            Image.LANCZOS

        )


        card.alpha_composite(

            frame

        )



    draw = ImageDraw.Draw(

        card

    )



    # =====================
    # ТЕКСТ
    # =====================


    draw_text(

        draw,

        CARD_LAYOUT["number"],

        f"#{card_number}",

        36

    )



    draw_text(

        draw,

        CARD_LAYOUT["champion"],

        champion,

        54

    )



    draw_text(

        draw,

        CARD_LAYOUT["skin"],

        skin,

        38,

        False

    )



    # =====================
    # СТАТЫ
    # =====================


    draw_text(

        draw,

        CARD_LAYOUT["attack"],

        str(attack),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["health"],

        str(health),

        50

    )


    draw_text(

        draw,

        CARD_LAYOUT["defense"],

        str(defense),

        50

    )



    # =====================
    # НИЗ
    # =====================


    draw_text(

        draw,

        CARD_LAYOUT["region_text"],

        region,

        34

    )


    draw_text(

        draw,

        CARD_LAYOUT["rarity"],

        rarity,

        34

    )



    # =====================
    # СОХРАНЕНИЕ
    # =====================


    filename = (

        f"{champion}_{skin}_{card_number}.png"

    ).replace(

        " ",

        "_"

    )


    path = os.path.join(

        OUTPUT,

        filename

    )


    card.save(

        path,

        "PNG"

    )


    return path
