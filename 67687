import json
import os


JSON_FILE = "data/champions.json"


# откуда брать регионы
CHAMPION_PATH = "assets/champions"



def load_regions():

    regions = {}


    if not os.path.exists(CHAMPION_PATH):

        print(
            "❌ Нет папки assets/champions"
        )

        return regions



    for region in os.listdir(CHAMPION_PATH):


        region_path = os.path.join(
            CHAMPION_PATH,
            region
        )


        if not os.path.isdir(region_path):

            continue



        for champion in os.listdir(region_path):


            champion_path = os.path.join(
                region_path,
                champion
            )


            if os.path.isdir(champion_path):

                regions[champion] = region



    return regions





def main():


    if not os.path.exists(JSON_FILE):

        print(
            "❌ Нет champions.json"
        )

        return



    with open(
        JSON_FILE,
        "r",
        encoding="utf-8"
    ) as f:

        champions = json.load(f)




    regions = load_regions()



    updated = 0



    for champion, data in champions.items():


        if champion in regions:


            data["region"] = regions[champion]

            updated += 1




    with open(
        JSON_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            champions,
            f,
            ensure_ascii=False,
            indent=4
        )



    print(
        f"✅ Обновлено регионов: {updated}"
    )





if __name__ == "__main__":

    main()
